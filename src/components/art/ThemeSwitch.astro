<button class="theme-switch" type="button" role="switch" aria-checked="false" aria-label="夜间主题" title="切换昼夜" data-theme-switch>
  <span class="theme-orbit" aria-hidden="true"><svg viewBox="0 0 24 24" class="sun"><circle cx="12" cy="12" r="4"/><path d="M12 1v2m0 18v2M1 12h2m18 0h2M4.2 4.2l1.4 1.4m12.8 12.8 1.4 1.4M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg><svg viewBox="0 0 24 24" class="moon"><path d="M20 15A9 9 0 0 1 9 4a9 9 0 1 0 11 11Z"/></svg></span>
  <span class="day-label">白昼</span><span class="night-label">夜间</span>
</button>
<script>
  import {resolveTheme} from '../../domain/scenery';
  const root=document.documentElement;
  const button=document.querySelector<HTMLButtonElement>('[data-theme-switch]');
  const sync=()=>button?.setAttribute('aria-checked',String(root.dataset.theme==='night'));
  sync();
  button?.addEventListener('click',()=>{
    const next=root.dataset.theme==='night'?'day':'night';
    root.dataset.theme=next;
    try{localStorage.setItem('village-theme',next);}catch{/* Theme works without storage. */}
    sync();
  });
  window.addEventListener('storage',event=>{
    if(event.key==='village-theme'){root.dataset.theme=resolveTheme(event.newValue,matchMedia('(prefers-color-scheme: dark)').matches);sync();}
  });
</script>
<style>
  .theme-switch{display:flex;align-items:center;gap:.5rem;border-radius:100px;padding:.4rem .8rem;min-height:40px;white-space:nowrap;font-size:.8rem;background:transparent}
  .theme-orbit{position:relative;width:20px;height:20px;display:block;overflow:hidden}.theme-orbit svg{position:absolute;inset:0;width:20px;fill:none;stroke:currentColor;stroke-width:1.5;transition:transform .6s,opacity .6s}.moon{transform:translateY(25px) rotate(-40deg);opacity:0}.night-label{display:none}
  :global([data-theme=night]) .sun{transform:translateY(-25px) rotate(90deg);opacity:0}:global([data-theme=night]) .moon{transform:none;opacity:1}:global([data-theme=night]) .day-label{display:none}:global([data-theme=night]) .night-label{display:inline}
</style>
