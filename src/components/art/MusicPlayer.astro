---
import {withBase} from '../../lib/sitePath';
import { getI18n } from '../../i18n/server';
const { t } = getI18n(Astro.url);
const messages = {
  play: t('播放背景音乐'),
  pause: t('暂停背景音乐'),
  idle: t('主旋律 · 点击音符播放'),
  playing: t('主旋律 · 正在播放'),
  blocked: t('点击页面后开始播放 · 可随时暂停'),
  failed: t('音乐暂时无法播放，请点击音符重试'),
  loadFailed: t('音乐暂时无法加载，请重试'),
};
---
<div class="music-player" transition:persist="background-music" data-messages={JSON.stringify(messages)}>
  <button class="music-toggle" type="button" aria-label={messages.play} aria-pressed="false" title={messages.play}><svg viewBox="0 0 24 24" aria-hidden="true"><path class="play-icon" d="m9 5 11 7-11 7Z"/><path class="pause-icon" d="M7 5h3v14H7zm7 0h3v14h-3z"/></svg></button>
  <div class="music-settings">
    <div class="music-popover"><label>{t('音乐音量')}<input class="music-volume" type="range" min="0" max="1" step="0.05" value="0.05" /></label><small role="status">{messages.idle}</small></div>
  </div>
  <audio preload="none" loop data-src={withBase('/audio/main-theme.mp3')}></audio>
</div>
<script>
  const player=document.querySelector<HTMLElement>('.music-player');
  if(player){
    const audio=player.querySelector('audio')!;
    const toggle=player.querySelector<HTMLButtonElement>('.music-toggle')!;
    const volume=player.querySelector<HTMLInputElement>('.music-volume')!;
    const status=player.querySelector<HTMLElement>('[role="status"]')!;
    const text=JSON.parse(player.dataset.messages!) as Record<'play'|'pause'|'idle'|'playing'|'blocked'|'failed'|'loadFailed',string>;
    const key='village-music';
    let savedTime=0,wanted=false,blocked=false;
    try{
      const state=JSON.parse(localStorage.getItem(key)||'null');
      if(state){
        if(Number.isFinite(state.volume))volume.value=String(Math.max(0,Math.min(1,state.volume)));
        if(Number.isFinite(state.time))savedTime=Math.max(0,state.time);
        // A fresh visit starts silent; page swaps retain the active audio element.
      }
    }catch{/* Storage may be unavailable in private browsing. */}
    audio.volume=Number(volume.value);
    const save=()=>{try{localStorage.setItem(key,JSON.stringify({volume:audio.volume,time:savedTime||audio.currentTime,playing:wanted}));}catch{/* Optional preference. */}};
    const update=()=>{
      const playing=!audio.paused;
      toggle.setAttribute('aria-pressed',String(playing));
      toggle.setAttribute('aria-label',playing?text.pause:text.play);
      toggle.title=playing?text.pause:text.play;
      status.textContent=playing?text.playing:text.idle;
    };
    const play=async()=>{
      if(!audio.getAttribute('src'))audio.src=audio.dataset.src!;
      else if(audio.error)audio.load();
      try{await audio.play();blocked=false;if(!wanted)audio.pause();save();}
      catch(error){
        blocked=error instanceof DOMException&&error.name==='NotAllowedError';
        update();status.textContent=blocked?text.blocked:text.failed;
        // Browser policy is not a user preference. Only the toggle changes wanted.
        save();
      }
    };
    audio.addEventListener('loadedmetadata',()=>{
      if(savedTime>0&&Number.isFinite(audio.duration))audio.currentTime=savedTime%audio.duration;
      savedTime=0;
    });
    audio.addEventListener('play',update);audio.addEventListener('pause',update);
    audio.addEventListener('error',()=>{update();status.textContent=text.loadFailed;});
    toggle.addEventListener('click',()=>{
      if(audio.paused){wanted=true;void play();}
      else{wanted=false;audio.pause();save();}
    });
    volume.addEventListener('input',()=>{audio.volume=Number(volume.value);save();});
    const activate=(event:Event)=>{
      if(!event.isTrusted||!blocked||!wanted||!audio.paused)return;
      if(event.target instanceof Element&&event.target.closest('.music-player'))return;
      blocked=false;void play();
    };
    document.addEventListener('click',activate);document.addEventListener('keydown',activate);
    const hide=()=>save();
    const show=(event:PageTransitionEvent)=>{if(event.persisted&&wanted&&audio.paused)void play();};
    window.addEventListener('pagehide',hide);
    window.addEventListener('pageshow',show);
    if(wanted)void play();
    if(import.meta.hot)import.meta.hot.dispose(()=>{save();audio.pause();document.removeEventListener('click',activate);document.removeEventListener('keydown',activate);window.removeEventListener('pagehide',hide);window.removeEventListener('pageshow',show);});
  }
</script>
<style>
  .music-player .music-popover{position:static;width:auto;padding:0;border:0;box-shadow:none;background:transparent}.music-settings{min-width:0;flex:1}.music-player{gap:.8rem}.music-player .music-volume{min-height:28px}.music-toggle svg{display:block;width:20px;height:20px;fill:currentColor}.pause-icon{display:none}.music-toggle[aria-pressed=true] .pause-icon{display:block}.music-toggle[aria-pressed=true] .play-icon{display:none}
  .music-player{display:flex;flex:none;align-items:center;position:relative;color:var(--ink)}
  .music-toggle{font-size:1.35rem;line-height:1;padding:.55rem .6rem;background:transparent;border:1px solid var(--border);border-radius:50%;color:inherit;cursor:pointer}
  .music-toggle[aria-pressed="true"]{color:var(--green);box-shadow:0 0 12px color-mix(in srgb,var(--green) 18%,transparent)}
  summary{cursor:pointer;list-style:none;padding:.4rem .2rem}summary::-webkit-details-marker{display:none}
  .music-popover{position:absolute;right:0;top:calc(100% + .8rem);width:210px;padding:1rem;background:var(--paper);border:1px solid var(--border);border-radius:12px;box-shadow:0 8px 24px #0002}
  label{display:grid;gap:.6rem;font-size:.85rem}input{width:100%;accent-color:var(--green)}small{display:block;margin-top:.7rem;font-size:.72rem;color:var(--muted)}
  @media(max-width:520px){.music-toggle{padding:.4rem;font-size:1.15rem}summary{padding:.3rem .1rem}}
  .music-toggle{flex:0 0 44px;width:44px;height:44px;min-width:44px;min-height:44px;padding:0;display:grid;place-items:center}
</style>
