<canvas class="falling-leaves" aria-hidden="true"></canvas>
<script>
  import {LeafWorld,SETTLE,particleViewport,shouldDrawLeaves,type Leaf} from '../../domain/leaves';
  import {onPageMount} from '../../lib/pageLifecycle';
  import {crossfadeRoot} from '../../lib/rootCrossfade';
  import {fixedSeason} from '../../lib/seasonPreference';
  const colors=[['#f8c4d7','#efb1c8','#ffe2e9'],['#70974e','#a4b868','#527c4a'],['#c74f3f','#de733e','#aa353c'],['#e4edf0','#f5f5ed','#cbdfe8']];
  // Cache the painted leaves once, not hundreds of paths on every frame.
  const sprites=colors.map((palette,season)=>palette.map(color=>{
    const tile=document.createElement('canvas');tile.width=48;tile.height=48;
    const p=tile.getContext('2d')!;p.translate(24,24);
    p.beginPath();
    if(season===0){
      // Single notched sakura petal, not a whole blossom.
      p.moveTo(0,17);p.bezierCurveTo(-17,6,-17,-13,-5,-15);p.quadraticCurveTo(-1,-14,0,-8);p.quadraticCurveTo(4,-16,9,-13);p.bezierCurveTo(20,-4,10,11,0,17);
    }else if(season===1){
      p.moveTo(-17,0);p.bezierCurveTo(-8,-15,10,-12,17,0);p.bezierCurveTo(4,11,-7,12,-17,0);
    }else if(season===2){
      const points=[[0,-20],[5,-9],[9,-13],[9,-3],[18,-7],[15,1],[20,3],[7,10],[3,10],[1,18],[-1,18],[-2,10],[-9,11],[-19,3],[-14,1],[-18,-7],[-8,-3],[-9,-13],[-4,-9]];
      points.forEach(([x,y],i)=>i?p.lineTo(x,y):p.moveTo(x,y));p.closePath();
    }else{
      p.strokeStyle=color;p.lineWidth=1.6;p.lineCap='round';
      for(let i=0;i<6;i++){p.save();p.rotate(i*Math.PI/3);p.moveTo(0,0);p.lineTo(0,-16);p.moveTo(0,-10);p.lineTo(-4,-13);p.moveTo(0,-10);p.lineTo(4,-13);p.restore();}p.stroke();return tile;
    }
    const fill=p.createLinearGradient(-10,-12,10,14);fill.addColorStop(0,color);fill.addColorStop(1,season===0?'#e6a1bb':season===2?'#923d31':'#586044');p.fillStyle=fill;p.fill();
    if(season!==0){p.strokeStyle='#eed7a47a';p.lineWidth=.8;p.beginPath();if(season===1){p.moveTo(-17,0);p.lineTo(15,0);}else{p.moveTo(0,16);p.lineTo(0,-14);p.moveTo(0,6);p.lineTo(-12,-2);p.moveTo(0,6);p.lineTo(12,-2);}p.stroke();}
    return tile;
  }));
  // Seen from our slightly top-down view, a leaf lying in the drift shows mostly its edge.
  const FLAT=.3;
  const seasons=['spring','summer','autumn','winter'];
  // The drift outlives page swaps, like leaves on the ground.
  const world=new LeafWorld(800);
  // Settled leaves are painted once into this strip; each frame copies it instead of redrawing hundreds of leaves.
  const drift=document.createElement('canvas'),driftContext=drift.getContext('2d')!;
  const dispose=onPageMount(()=>{
  const canvas=document.querySelector<HTMLCanvasElement>('.falling-leaves');
  const context=canvas?.getContext('2d');
  if(canvas&&context){
    const ctx=context;
    const reduced=matchMedia('(prefers-reduced-motion: reduce)');
    let frame=0,last=0,spawnClock=0,statsClock=0,scale=1,width=innerWidth,height=innerHeight,driftTop=0,painted=true;
    let viewport=particleViewport(width,height),spawnRate=viewport.spawnRate,speedScale=viewport.speedScale;
    // repick: the season may have changed under leaves of another one (picked by hand, or while this canvas was away).
    // turning: the crossfade has not yet switched the season, so new leaves would still be of the old one.
    let repick=true,turning=false;
    const upcoming=(season:number)=>{const fixed=fixedSeason();return fixed==='auto'?seasons[(season+1)%4]:fixed;};
    const pose=(leaf:Leaf):[number,number]=>{
      if(leaf.state==='pile'||leaf.state==='slide')return [leaf.wide,FLAT];
      if(leaf.state==='settle'){const t=Math.min(1,leaf.age/SETTLE);return [1+(leaf.wide-1)*t,FLAT+(1-FLAT)*(1-t)];}
      if(leaf.season===3)return [1,1];
      const swing=Math.abs(Math.cos(leaf.phase));
      switch(leaf.fall){
        // Flips over and over.
        case 'tumble':return [1,.15+.85*Math.abs(Math.cos(leaf.flip))];
        // Lies almost flat as it whirls.
        case 'spin':return [1,.75+.25*swing];
        // Turns side-on while it moves toward or away from us.
        case 'spiral':return [.4+.6*swing,.75];
        // Edge-on at the end of each swing; a swooper stalls almost edge-on.
        case 'swoop':return [1,.25+.75*swing];
        default:return [1,.45+.55*swing];
      }
    };
    const paint=(target:CanvasRenderingContext2D,leaf:Leaf,top:number)=>{
      // Fading leaves turn transparent; melting snowflakes also shrink, and those in the drift sink onto the snow below.
      // A corkscrewing leaf looks a little larger on the near side of its circle.
      const near=leaf.state==='air'&&leaf.fall==='spiral'?1+.14*Math.cos(leaf.phase):1;
      const [wide,tall]=pose(leaf),full=leaf.r*2.8,melt=leaf.season===3?.25+.75*leaf.life:1,size=full*melt*near;
      const sink=leaf.state==='pile'?(full-full*melt)*FLAT/2:0,cos=Math.cos(leaf.angle)*scale,sin=Math.sin(leaf.angle)*scale;
      target.globalAlpha=.88*leaf.life;
      target.setTransform(cos,sin,-sin,cos,leaf.x*scale,(leaf.y+sink-top)*scale);
      target.drawImage(sprites[leaf.season][leaf.id%3],-size/2*wide,-size/2*tall,size*wide,size*tall);
    };
    const paintDrift=()=>{
      if(world.pileChanged){
        const strip=Math.ceil(world.depth+40),w=Math.round(width*scale),h=Math.round(strip*scale);
        driftTop=height-strip;
        if(drift.width!==w||drift.height!==h){drift.width=w;drift.height=h;}
        else{driftContext.setTransform(1,0,0,1,0,0);driftContext.clearRect(0,0,w,h);}
        for(const leaf of world.pile)paint(driftContext,leaf,driftTop);
        world.pileChanged=false;world.landed.length=0;
      }else{
        for(const leaf of world.landed)paint(driftContext,leaf,driftTop);
        world.landed.length=0;
      }
    };
    const resize=()=>{
      width=innerWidth;height=innerHeight;
      viewport=particleViewport(width,height);
      scale=Math.min(devicePixelRatio||1,1.5);
      canvas.width=Math.round(width*scale);canvas.height=Math.round(height*scale);
      world.resize(width,height);painted=true;
    };
    const running=()=>!document.hidden&&!reduced.matches&&document.documentElement.dataset.particles!=='off';
    const draw=(now:number)=>{
      frame=0;
      if(!running())return;
      frame=requestAnimationFrame(draw);
      if(last&&!shouldDrawLeaves(now-last))return;
      const dt=Math.min((now-(last||now))/1000,1/30);last=now;
      const adapt=1-Math.exp(-2*dt);
      spawnRate+=(viewport.spawnRate-spawnRate)*adapt;speedScale+=(viewport.speedScale-speedScale)*adapt;
      spawnClock+=dt*spawnRate;statsClock+=dt;
      const root=document.documentElement,season=Math.max(0,seasons.indexOf(root.dataset.season||'spring'));
      // Leaves left over from another season fade out instead of lying under the new palette.
      if(repick){repick=false;world.fade(season);}
      // A gentle trickle; 800 is the pool ceiling, not a burst of 800 particles.
      if(spawnClock>=1){spawnClock%=1;if(!turning)world.spawn(12+Math.random()*Math.max(1,width-24),-16,season);}
      const event=world.step(dt,speedScale);
      if(event==='full'){
        // Into spring, the breeze lifts the loose snow and the packed snow under it melts. Anything else, and snow that
        // stays winter, blows away.
        let snow=0;for(const leaf of world.pile)if(leaf.season===3)snow++;
        world.sweep(snow*2>world.pile.length&&upcoming(season)!=='winter'?'thaw':'gust');
        spawnClock=0;
      }else if(event==='cleared'){
        // The season turns only once the drift has mostly gone, so old leaves never lie on the new palette.
        const next=upcoming(season);turning=true;
        const apply=()=>{turning=false;root.dataset.season=next;window.dispatchEvent(new CustomEvent('season-bottom-exit',{detail:seasons.indexOf(next)}));};
        if(next!==root.dataset.season)crossfadeRoot(apply);else apply();
        spawnClock=0;
      }
      if(import.meta.env.DEV&&statsClock>1){canvas.dataset.leaves=String(world.leaves.length);canvas.dataset.resting=String(world.pile.length);statsClock=0;}
      // Nothing moving and the drift unchanged: the canvas already shows it, and an untouched canvas costs nothing.
      const idle=!world.leaves.length&&!world.pileChanged&&!world.landed.length;
      if(idle&&!painted)return;
      paintDrift();
      ctx.setTransform(1,0,0,1,0,0);ctx.clearRect(0,0,canvas.width,canvas.height);
      if(world.pile.length)ctx.drawImage(drift,0,Math.round(driftTop*scale));
      for(const leaf of world.leaves)if(leaf.y>-20)paint(ctx,leaf,0);
      ctx.globalAlpha=1;
      painted=!idle;
    };
    const resume=()=>{if(frame)cancelAnimationFrame(frame);frame=0;last=0;if(running())frame=requestAnimationFrame(draw);};
    const reset=()=>{
      world.clear();spawnClock=0;ctx.setTransform(1,0,0,1,0,0);ctx.clearRect(0,0,canvas.width,canvas.height);
      const fixed=fixedSeason();document.documentElement.dataset.season=fixed==='auto'?'spring':fixed;
      window.dispatchEvent(new CustomEvent('season-bottom-exit',{detail:0}));
    };
    const motion=()=>{if(reduced.matches)reset();resume();};
    // Swipes blow leaves around. Small pointer steps accumulate until the movement is worth a gust of air.
    let pointer:{x:number;y:number;time:number}|undefined;
    const sweep=(event:PointerEvent)=>{
      if(pointer&&event.timeStamp-pointer.time<150){
        if((event.clientX-pointer.x)**2+(event.clientY-pointer.y)**2<16)return;
        world.blow(pointer.x,pointer.y,event.clientX,event.clientY,(event.timeStamp-pointer.time)/1000);
      }
      pointer={x:event.clientX,y:event.clientY,time:event.timeStamp};
    };
    const lift=()=>{pointer=undefined;};
    const picked=()=>{repick=true;};
    window.addEventListener('season-preference-change',picked);
    window.addEventListener('pointermove',sweep,{passive:true});window.addEventListener('pointercancel',lift);
    window.addEventListener('resize',resize);
    document.addEventListener('visibilitychange',resume);reduced.addEventListener('change',motion);
    window.addEventListener('particles-preference-change',resume);
    const hide=()=>{if(frame)cancelAnimationFrame(frame);frame=0;last=0;};
    window.addEventListener('pagehide',hide);
    window.addEventListener('pageshow',resume);
    resize();resume();
    return()=>{
      if(frame)cancelAnimationFrame(frame);
      window.removeEventListener('season-preference-change',picked);
      window.removeEventListener('pointermove',sweep);window.removeEventListener('pointercancel',lift);
      window.removeEventListener('resize',resize);
      document.removeEventListener('visibilitychange',resume);reduced.removeEventListener('change',motion);
      window.removeEventListener('particles-preference-change',resume);
      window.removeEventListener('pagehide',hide);window.removeEventListener('pageshow',resume);
    };
  }
  });
  if(import.meta.hot)import.meta.hot.dispose(dispose);
</script>
<style>
  .falling-leaves{position:fixed;inset:0;width:100%;height:100%;z-index:25;pointer-events:none}
  @media(prefers-reduced-motion:reduce){.falling-leaves{display:none}}
</style>
