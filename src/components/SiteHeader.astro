---
import { withBase } from '../lib/sitePath';
import { getI18n } from '../i18n/server';
import { stripLocale } from '../i18n/locales';
import PageSettings from './PageSettings.astro';
import LanguageSelector from './LanguageSelector.astro';
import SupportDialog from './SupportDialog.astro';
const { t, href } = getI18n(Astro.url);
const navigation = [
  { href: '/data/', label: t('资料库') },
  { href: '/planner/', label: t('收益规划') },
  { href: '/planner/workflow/', label: t('工作流') },
  { href: '/guides/', label: t('攻略') },
  { href: '/save-editor/', label: t('存档工具') },
  { href: '/search/', label: t('搜索') },
];
const path = stripLocale(Astro.url.pathname);
const current = navigation.filter(item => path.startsWith(item.href)).sort((a,b)=>b.href.length-a.href.length)[0]?.href;
---

<header class="site-header">
  <a class="brand" href={href("/")}><img src={withBase('/favicon.svg')} width="38" height="38" alt="" /><strong>{t('静谧田园 Wiki')}</strong></a>
  <nav aria-label={t('页首导航')}>{navigation.map(item=><a href={href(item.href)} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>)}</nav>
  <div class="header-controls"><SupportDialog /><LanguageSelector /><PageSettings /></div>
</header>
<style>
  .header-controls{flex-wrap:wrap;justify-content:flex-end}
  .header-controls :global(.season-selector .sr-only){position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
  @media(max-width:1000px){.site-header{height:auto!important;min-height:64px;flex-wrap:wrap;padding-block:.55rem}.header-controls{max-width:100%}}
  .site-header { position: sticky; top: 0; z-index: 30; height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0 max(1rem, calc((100vw - var(--max))/2 + 1rem)); border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--paper) 90%, transparent); backdrop-filter: blur(14px); }
  .brand { display: flex; align-items: center; gap: .7rem; color: var(--ink); text-decoration: none; }
  .brand img { display: block; border-radius: 10px; box-shadow: 0 1px 3px #0002; }
  .brand span { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50% 45% 50% 40%; background: var(--green); color: var(--paper-raised); font-family: serif; }
  nav { display: flex; gap: 1.2rem; } nav a { color: var(--ink); text-decoration: none; font-size: .92rem; }
  .header-controls{display:flex;align-items:center;gap:.8rem}nav a{position:relative;padding:.55rem 0}nav a::after{content:'';height:1px;background:var(--green);position:absolute;bottom:0;left:0;right:0;transform:scaleX(0);transform-origin:left;transition:transform .25s}nav a:hover::after{transform:scaleX(1)}
  nav a[aria-current="page"]{color:var(--green);font-weight:700}nav a[aria-current="page"]::after{transform:scaleX(1)}nav a{white-space:nowrap}
  @media(max-width:520px){nav{gap:.5rem}nav a{font-size:.82rem}}
  @media(max-width:520px){.brand strong{font-size:.8rem}.brand{gap:.4rem}.header-controls{gap:.4rem}.site-header{gap:.3rem}.header-controls :global(.quality-selector label){display:none}.header-controls :global(.theme-switch){padding:.35rem .5rem}}
  @media (max-width: 760px) { .site-header { height: auto; min-height: 64px; flex-wrap: wrap; padding-top: .55rem; padding-bottom: .55rem; } }
</style>
