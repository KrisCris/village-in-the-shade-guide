---
import { kindLabels, primaryKinds } from '../data/types';
---
<aside class="sidebar">
  <nav aria-label="主要分类">
    <p>资料库</p>
    <a href="/categories/">分类一览</a>
    {primaryKinds.map((kind) => <a href={`/data/${kind}/`}>{kindLabels[kind]}</a>)}
    <p>攻略</p>
    <a href="/guides/season-plan/">四季留货规划</a>
    <a href="/guides/residents/">生日与送礼</a>
    <a href="/guides/collection-map/">图书与神社地图</a>
    <a href="/guides/#系统与生活">新手与系统</a>
    <a href="/guides/#剧情">剧情流程</a>
    <a href="/guides/#探索">探索收集</a>
  </nav>
</aside>
<style>
  .sidebar { border-right: 1px solid var(--border); padding: 1.6rem 1rem 5rem; }
  nav { position: sticky; top: 86px; display: grid; gap: .25rem; }
  p { margin: 1rem .7rem .35rem; color: var(--muted); font-size: .76rem; font-weight: 800; letter-spacing: .12em; }
  a { padding: .58rem .7rem; border-radius: 8px; color: var(--ink); text-decoration: none; } a:hover { background: var(--green-soft); color: var(--green); }
  @media (max-width: 800px) { .sidebar { display: none; } }
</style>
