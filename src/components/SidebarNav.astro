---
import { currentLink, currentSection, databaseLinks, guideGroups, patchGuide, plannerLinks, sections, type SectionId } from '../data/navigation';
import { getI18n } from '../i18n/server';
import { stripLocale } from '../i18n/locales';
const { t, href } = getI18n(Astro.url);
const path = stripLocale(Astro.url.pathname);
type Block = { group?: string; links: Array<{ href: string; label: string }> };
const translated = (links: Array<{ href: string; label: string }>) => links.map(link => ({ href: link.href, label: t(link.label) }));
// The profit ranking card on /guides/ is the planner, already listed in its own section.
const groups = guideGroups.map(group => ({ ...group, guides: group.guides.filter(guide => guide.href.startsWith('/guides/')) }));
const blocks: Record<SectionId, Block[]> = {
  database: [{ links: translated(databaseLinks) }],
  planner: [{ links: translated(plannerLinks) }],
  guides: [
    { links: [{ href: '/guides/', label: t('全部攻略') }, { href: patchGuide.href, label: t(patchGuide.label ?? patchGuide.title) }] },
    ...groups.map(group => ({ group: t(group.label), links: group.guides.map(guide => ({ href: guide.href, label: t(guide.label ?? guide.title) })) })),
  ],
};
const sectionId = currentSection(path);
const active = sectionId && currentLink(path, blocks[sectionId].flatMap(block => block.links.map(link => link.href)));
// Sections keep their order and all render open; the script scrolls to the current link
// instead of folding the others (the phone menu still opens only the current section).
---
<aside class="sidebar">
  <button class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="sidebar-links">{t('主要分类')}<span aria-hidden="true">⌄</span></button>
  <nav id="sidebar-links" aria-label={t('主要分类')} data-section={sectionId}>
    {sections.map(section => <details open data-section={section.id}>
      <summary>{t(section.label)}</summary>
      <div class="section-links">{blocks[section.id].map(block => <>
        {block.group && <p>{block.group}</p>}
        {block.links.map(link => <a href={href(link.href)} aria-current={link.href === active ? 'page' : undefined}>{link.label}</a>)}
      </>)}</div>
    </details>)}
  </nav>
</aside>
<script>
  import {onPageMount} from '../lib/pageLifecycle';
  import {keepSidebarAcrossSwaps, prepareSidebar} from '../lib/sidebarNav';
  const stopKeeping=keepSidebarAcrossSwaps();
  const dispose=onPageMount(()=>{
  document.querySelectorAll<HTMLButtonElement>('.mobile-nav-toggle').forEach(button => {
    button.addEventListener('click', () => {
      button.setAttribute('aria-expanded', String(button.getAttribute('aria-expanded') !== 'true'));
    });
  });
  prepareSidebar();
  });
  if(import.meta.hot)import.meta.hot.dispose(()=>{dispose();stopKeeping();});
</script>
<style>
  .sidebar { border-right: 1px solid var(--border); padding: 1.6rem 1rem 5rem; }
  .mobile-nav-toggle { display: none; }
  nav { position: sticky; top: 86px; max-height: calc(100vh - 96px); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; display: grid; align-content: start; gap: .25rem; padding: 2px; }
  summary { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-top: .6rem; padding: .4rem .7rem; border-radius: 8px; color: var(--muted); font-size: .76rem; font-weight: 800; letter-spacing: .12em; cursor: pointer; list-style: none; }
  details:first-child > summary { margin-top: 0; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '›'; font-size: 1rem; letter-spacing: 0; transition: transform .2s; }
  details[open] > summary::after { transform: rotate(90deg); }
  summary:hover { background: var(--green-soft); }
  p { margin: .7rem .7rem .15rem; color: var(--muted); font-size: .74rem; font-weight: 700; letter-spacing: .04em; }
  .section-links { display: grid; gap: .1rem; }
  a { padding: .58rem .7rem; border-radius: 8px; color: var(--ink); text-decoration: none; } a:hover { background: var(--green-soft); color: var(--green); }
  nav a[aria-current="page"] { background: var(--green-soft); color: var(--green); font-weight: 700; border-left-color: var(--green); }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--green); outline-offset: -2px; }
  @media (max-width: 800px) {
    .sidebar { border-right: 0; border-bottom: 1px solid var(--border); padding: .6rem 1rem; }
    .mobile-nav-toggle { display: flex; width: 100%; min-height: 44px; align-items: center; justify-content: space-between; padding: .6rem .7rem; border: 1px solid var(--border); border-radius: 8px; background: var(--paper-raised); color: var(--ink); font: inherit; cursor: pointer; }
    .mobile-nav-toggle[aria-expanded="true"] span { transform: rotate(180deg); }
    nav { display: none; position: static; max-height: none; overflow: visible; padding-bottom: .5rem; }
    .mobile-nav-toggle[aria-expanded="true"] + nav { display: grid; }
    summary { min-height: 44px; }
    .section-links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    p { grid-column: 1 / -1; }
  }
</style>
