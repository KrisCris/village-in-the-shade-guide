---
import { withBase } from '../lib/sitePath';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/interior.css';
import '../styles/season-palettes.css';
import SiteHeader from '../components/SiteHeader.astro';
import SidebarNav from '../components/SidebarNav.astro';
import SeasonScene from '../components/art/SeasonScene.astro';
import FallingLeaves from '../components/art/FallingLeaves.astro';
interface Props { title: string; description?: string; immersive?: boolean; }
const { title, description = '《静谧田园》（Village in the Shade）中文版数据 Wiki 与攻略', immersive=false } = Astro.props;
const dynamicInterior = !immersive;
---
<!doctype html>
<html lang="zh-CN" data-season="spring">
  <head>
    <ClientRouter fallback="swap" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="Q8Z9UGOo12W6iNMjAKeC86wq4Wu6IEM8plWaLC8FXG4" />
    <meta name="theme-color" content="#ece8db" />
    <script is:inline data-astro-rerun>
      (()=>{let theme;try{theme=localStorage.getItem('village-theme');}catch{}document.documentElement.dataset.theme=theme==='day'||theme==='night'?theme:matchMedia('(prefers-color-scheme: dark)').matches?'night':'day';})();
    </script>
    <link rel="icon" href={withBase("/game-icon.png")} />
    <title>{title} · 静谧田园 Wiki</title>
  </head>
  <body class:list={[immersive?'home-page':'wiki-page', {'dynamic-interior':dynamicInterior}]}>
    <a class="skip-link" href="#main-content">跳至正文</a>
    <SiteHeader />
    {!immersive && <FallingLeaves />}
    {dynamicInterior ? <><SeasonScene /><div class="interior-scene-veil" aria-hidden="true"></div></> : !immersive&&<div class="interior-scenery" aria-hidden="true"><img class="interior-mountains" src={withBase('/art/mountains-spring.webp')} alt="" loading="lazy"/><img class="interior-foliage" src={withBase('/art/pine-spring.webp')} alt="" width="256" height="312" loading="lazy"/></div>}
    <div class:list={['page',{'immersive-page':immersive}]}>
      {!immersive&&<SidebarNav />}
      <main class="main" id="main-content" data-pagefind-body><slot /></main>
    </div>
    <footer class="site-footer"><a href={withBase('/')}>静谧田园 Wiki</a><span>《静谧田园》© NIS · 非官方指南 · 作者：_connlost</span><a href="https://github.com/KrisCris/village-in-the-shade-guide">GitHub ↗</a></footer>
  </body>
</html>
