---
import { withBase } from '../../lib/sitePath';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { characterGuideRedirects, guides, localizeGuide, spoilerCategories } from '../../data/guideContent';
import { getI18n } from '../../i18n/server';
import { interpolate } from '../../i18n/translate';
export function getStaticPaths() {
  return [
    ...guides.map((guide) => ({ params: { sourceId: guide.sourceId }, props: { guide, redirectTarget: undefined } })),
    ...characterGuideRedirects.map(({ sourceId, target }) => ({ params: { sourceId }, props: { guide: undefined, redirectTarget: target } })),
  ];
}
const { guide, redirectTarget } = Astro.props;
const { t, href, locale } = getI18n(Astro.url);
if (redirectTarget) return Astro.redirect(href(redirectTarget), 301);
if (!guide) throw new Error('Missing guide content');
if(guide.guideTarget)return Astro.redirect(href(guide.guideTarget));
const isSpoiler = spoilerCategories.has(guide.category);
const { title, headings } = localizeGuide(guide, locale);
---
<BaseLayout title={title} description={t('{title}：紧凑中文要点与游戏数据链接。', { title })}>
  <nav class="crumb"><a href={href("/guides/")}>{t('攻略')}</a><span>›</span><a href={href(`/guides/#${guide.category}`)}>{t(guide.category)}</a></nav>
  <p class="eyebrow">{t(guide.category)}</p><h1>{title}</h1>
  {guide.dataTarget && <a class="data-cta card" href={href(guide.dataTarget)}><span><strong>{t('打开完整数据表')}</strong><small>{t('支持搜索、筛选、排序与逐层展开关联')}</small></span><b>→</b></a>}
  {headings.length > 0 && <section><h2>{t('参考主题')}</h2><p>{t('这一主题的详细条件尚未全部从游戏数据核对。以下是待补充范围，不作为已验证的操作步骤。')}</p>
    {isSpoiler ? <details class="spoiler"><summary>{t('展开含剧透的流程与应对要点')}</summary><ol>{headings.map((heading) => <li>{heading}</li>)}</ol></details> : <ol class="steps">{headings.map((heading) => <li>{heading}</li>)}</ol>}
  </section>}
  <aside class="source-note"><strong>{t('来源与口径')}</strong><p>{interpolate(t('本页按 AppMedia 对应主题重新整理，未复制原文；价格、名称、配方和关联以本地游戏数据为准。需要查看原页面时可前往 {link}。'), { link: <a href={withBase(guide.url)} rel="nofollow">{t('AppMedia：{title}', { title: guide.title })}</a> })}</p></aside>
</BaseLayout>
<style>.crumb{display:flex;gap:.5rem;font-size:.86rem}.original{color:var(--muted);margin-top:-.5rem}.data-cta{display:flex;align-items:center;justify-content:space-between;max-width:680px;margin:1.5rem 0;padding:1rem 1.2rem;color:var(--ink);text-decoration:none}.data-cta span{display:grid;gap:.25rem}.data-cta small{color:var(--muted)}.data-cta b{font-size:1.5rem;color:var(--green)}section{margin-top:2.5rem}.steps,.spoiler ol{display:grid;gap:.55rem;padding-left:1.7rem;max-width:900px}.steps li,.spoiler li{padding:.7rem .8rem;border-bottom:1px solid var(--border);line-height:1.55}.spoiler{padding:1rem;border:1px solid var(--vermilion);border-radius:var(--radius);background:color-mix(in srgb,var(--paper-raised) 92%,transparent)}.spoiler summary{cursor:pointer;font-weight:750;color:var(--vermilion)}.source-note{margin-top:3rem;padding:1rem 1.2rem;border-left:4px solid var(--green);background:var(--green-soft);line-height:1.7}.source-note p{margin-bottom:0}</style>
