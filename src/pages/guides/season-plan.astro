  .mark-end{stroke:var(--muted)}
  .moon{position:absolute;top:4px;right:4px;width:7px;height:7px;border-radius:50%;background:var(--ink);opacity:.75}
  .month-legend{display:flex;flex-wrap:wrap;gap:.3rem .9rem;margin:.6rem 0 0;font-size:.74rem;color:var(--muted)}
  .month-legend span{display:inline-flex;align-items:center;gap:.35rem}
  .month-legend i{display:inline-block;width:12px;height:12px;border-radius:3px}
  .key-moon{background:radial-gradient(circle,var(--ink) 0 3px,transparent 3.5px);opacity:.75}
  .key-eve{background:repeating-linear-gradient(135deg,transparent 0 3px,color-mix(in srgb,var(--muted) 45%,transparent) 3px 4px);box-shadow:inset 0 0 0 1px var(--border)}
  .key-monday{box-shadow:inset 3px 0 0 var(--green),inset 0 0 0 1px var(--border);background:color-mix(in srgb,var(--paper) 60%,transparent)}

  .agenda{list-style:none;margin:0;padding:0;display:grid;gap:.1rem}
