---
import { withBase } from '../../lib/sitePath';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCatalog,entityUrl} from '../../data/repository';
import type {Entity} from '../../data/types';
import {seasonPlans,yearRoundCatalog,laterSeeds,type PlanBundle,type PlanStack} from '../../data/seasonPlan';
import {festivals,weekday,weekdayName,isWeekend,isFestivalEve,birthdayLabel,DAYS_PER_SEASON,LATE_NIGHT_DAYS,GIFTS,type CalendarFestival} from '../../data/calendar';
import {SEASON_GLYPHS} from '../../components/art/seasonGlyphs';
import {CALENDAR_ICONS,type CalendarIconName} from '../../components/art/calendarIcons';
import rules from '../../../data/sources/game-rules.json';
import kappa from '../../../data/sources/game-kappa-exchange.json';
import anomalies from '../../../data/sources/game-anomalies.json';
import { getI18n } from '../../i18n/server';
const {t,tHtml,href,locale}=getI18n(Astro.url);
const catalog=getCatalog(locale);
const plans=seasonPlans(catalog);
const fests=festivals(locale);
const fair=fests.find(f=>f.key==='FAIR')!;
const seasonNames=[t('春'),t('夏'),t('秋'),t('冬')];
const seasonTitle=(index:number)=>t('{season}季',{season:seasonNames[index]});
const weekdays=Array.from({length:7},(_,index)=>weekdayName(index,locale));
const url=(entity:Entity)=>href(entityUrl(entity));
const item=(id:string)=>catalog.byId[id];
/** Which clears ask for a shrine offering: the Nth clear takes the season's first N, and the 4th is the last. */
const clearTag=(slot:number)=>slot===1?t('每次都要'):slot===4?t('只在第 4 次完成时'):t('第 {n} 次完成起',{n:slot});
/** How many of one item a set of bundles asks for in total. */
function share(id:string,rows:PlanBundle[]){return rows.flatMap(r=>r.items).filter(s=>s.item.id===id).reduce((n,s)=>n+s.quantity,0);}
const list=(parts:string[])=>parts.join(t('、'));
const talk=rules.constants.NPC_LOVE_ADD_TALK.value;
const [nightStart,nightEnd]=anomalies.late_night.hours;
const liked=(person:Entity)=>((person.gift_items??[]) as {item_id:string;preference:number}[]).filter(g=>g.preference===1).map(g=>item(g.item_id)).filter(Boolean) as Entity[];
const sweetPotato=item('ITEM_ID_CROPS_SWEET_POTATO');
const aburaage=item('ITEM_ID_CURSED_FOX_ABURAAGE');

type Event={day:number;kind:CalendarIconName|'birthday';title:string;time?:string;notes:string[];person?:Entity;items?:Entity[]};
const festivalNotes:Record<string,string[]>={
  SAKURA_VIEWING:[t('第 2 年起才有。大家在广场赏花。')],
  FESTIVAL:[t('晚上广场摆摊。琪娜娜这天卖彩色小鸡，不卖其他家畜。')],
  HARVEST:[t('大家在广场烤红薯，游戏日历提醒带一个去。')],
  NEW_YEARS_EVE:[t('帮忙准备就能拿到年糕。')],
};
const hours=(festival:CalendarFestival)=>`${festival.start}–${festival.end}`;
function events(season:number):Event[]{
  const plan=plans[season];
  const rows:Event[]=[
    ...plan.birthdays.map(person=>({day:Number(person.birthday_day),kind:'birthday' as const,title:birthdayLabel(person.name.zh_hans,locale),notes:[],person,items:liked(person)})),
    ...fests.filter(f=>f.season===season).map(f=>({day:f.day,kind:'festival' as const,title:f.name,time:hours(f),notes:[...festivalNotes[f.key]??[],t('前一晚没有深夜。')],items:f.key==='HARVEST'&&sweetPotato?[sweetPotato]:undefined})),
    {day:fair.letterDay,kind:'letter',title:t('品评会通知信'),notes:[t('回信时选参加作物、家畜还是马的评鉴。')]},
    {day:fair.day,kind:'fair',title:t('品评会'),time:hours(fair),notes:[tHtml('按回信选的部门在广场参加，评分方法见<a href="/guides/crop-quality/#fair">作物品评会</a>和<a href="/guides/livestock-plan/#fair">家畜品评会</a>。'),t('前一晚没有深夜。')]},
    {day:DAYS_PER_SEASON,kind:'end',title:t('本季最后一天'),notes:[t('下一季不能生长的作物在换日时枯萎；季节稻草人 5×5 范围内的不会。')]},
  ];
  const order=['birthday','festival','fair','letter','end'];
  return rows.sort((a,b)=>a.day-b.day||order.indexOf(a.kind)-order.indexOf(b.kind));
}
const lateNight=(season:number,day:number)=>LATE_NIGHT_DAYS.includes(day)&&!isFestivalEve(season,day);
const kappaItem=item(kappa.input_item_id);
const yearRound=yearRoundCatalog(catalog);
const later=laterSeeds(catalog);
const mushrooms=['ITEM_ID_CROPS_SHIMEJI_MUSHROOM','ITEM_ID_CROPS_SHIITAKE_MUSHROOM'].map(item).filter(Boolean) as Entity[];
const shimeji=catalog.entities.find(e=>e.kind==='crops'&&e.id==='CROPS_ID_SHIMEJI');
/** Per-season panel data: the dated events, events grouped by day, and items both the shrine and the catalog ask for. */
const panels=plans.map(plan=>{
  const agenda=events(plan.season);
  const byDay=new Map<number,Event[]>();
  for(const event of agenda)byDay.set(event.day,[...byDay.get(event.day)??[],event]);
  const sharedItems=[...plan.shared].map(item).filter(Boolean) as Entity[];
  return {plan,agenda,byDay,sharedItems,shrineReward:plan.shrine[0]?.rewards[0]};
});
---
<BaseLayout title={t('四季规划：节日、生日与交付')} description={t('每季 28 天的节日、品评会、村民生日，以及狐狸神社供奉和村长家交付目录要留的东西。')}>
<div class="season-guide">
<h1>{t('四季规划：节日、生日与交付')}</h1>
<p class="lede">{t('一季 28 天，第 1 天总是星期一。按季节查看节日、品评会、村民生日，以及狐狸神社和村长家交付目录要留的东西。')}</p>

<section id="daily" class="routine" aria-labelledby="daily-title">
<div class="routine-steps">
<h2 id="daily-title">{t('每天的安排')}</h2>
<ol>
<li><b>{t('7:00 换日后')}</b><span>{t('收获、浇水、喂家畜；取出设备里做好的东西，放进新原料。')}</span></li>
<li><b>{t('去村长家')}</b><span>{t('交付目录里凑齐的项目当场交掉。0:00 以后进不了村民家，要交就趁早。')}</span></li>
<li><b>{t('遇到村民')}</b><span>{t('聊一句加 {talk} 点好感。礼物每人每天 {day} 份、每周 {week} 份，周一清零；生日当天送的不占这 {week} 份。',{talk,day:GIFTS.per_day,week:GIFTS.per_week})}</span></li>
<li><b>{t('出门')}</b><span set:html={tHtml('山菜按季节长出，鱼按季节和时段上钩，矿石去<a href="/guides/quarry/">采石场</a>。钓鱼时间看<a href="/guides/fishing-spots/">钓点指南</a>。')} /></li>
<li><b>{t('深夜')}</b><span set:html={tHtml('狐狸神社只在深夜（{start}:00–{end}:00）出现。每周有 {min}–{max} 次深夜：每季第 1、15 天和雷雨天一定有，节日前一晚没有，详见<a href="/guides/anomalies/#late-night">深夜规则</a>。',{start:nightStart,end:nightEnd,min:anomalies.late_night.weekly_count[0],max:anomalies.late_night.weekly_count[1]})} /></li>
<li><b>{t('出货前')}</b><span set:html={tHtml('先留出供奉、交付和礼物要用的，剩下的再卖或加工。加工划不划算看<a href="/planner/">收益规划</a>。')} /></li>
</ol>
</div>
<aside class="planner-cta card">
<p class="eyebrow">{t('工具 · 读取存档')}</p>
<h3>{t('让每日规划替你列今天的清单')}</h3>
<p>{t('选一个存档，每日规划会把上面这些事换成具体待办：今天能交齐哪些供奉和目录、设备里放什么、还缺哪些材料、空地种什么，以及这周谁过生日、你手上有没有对方喜欢的东西。')}</p>
<a class="button cta-button" href={href('/planner/today/')}>{t('打开每日规划')} →</a>
<small>{t('存档只在浏览器里读取，不会上传，也不会被修改。')}</small>
<a class="cta-secondary" href={href('/planner/workflow/')}>{t('在生产工作流中安排留货')} →</a>
</aside>
</section>

<section id="seasons" class="seasons" aria-label={t('四季')}>
<div class="season-tabs" role="tablist" aria-label={t('选择季节')}>
{plans.map(plan=><a role="tab" id={`tab-${plan.key}`} href={`#${plan.key}`} aria-controls={plan.key} data-season-tab={plan.key}>
<svg viewBox="-24 -24 48 48" aria-hidden="true" stroke-linecap="round" stroke-linejoin="round">{SEASON_GLYPHS[plan.key].map(shape=><path d={shape.d} fill={shape.fill ?? 'none'} stroke={shape.stroke} stroke-width={shape.strokeWidth} transform={shape.transform} />)}</svg>
<span>{seasonTitle(plan.season)}</span></a>)}
</div>

{panels.map(({plan,agenda,byDay,sharedItems,shrineReward})=><section id={plan.key} class="season-panel" role="tabpanel" aria-labelledby={`tab-${plan.key}`} data-season-panel={plan.key}>
<header class="panel-head">
<h2>{seasonTitle(plan.season)}</h2>
<nav class="panel-links" aria-label={t('{season}季相关',{season:seasonNames[plan.season]})}>
<a href={href(`/data/crops/?season=${plan.key}`)}>{t('本季种植')}</a>
<a href={href(`/data/fish/?season=${plan.key}`)}>{t('本季鱼与钓点时段')}</a>
<a href={href(`/guides/fishing-spots/#${plan.key}`)}>{t('本季钓鱼留货清单')}</a>
</nav>
</header>

<div class="calendar-block">
<div class="month card" aria-hidden="true">
<div class="month-head">{weekdays.map((name,index)=><span class:list={[{weekend:index>=5}]}>{name}</span>)}</div>
<ol class="month-grid">{Array.from({length:DAYS_PER_SEASON},(_,index)=>{
const day=index+1,list=byDay.get(day)??[];
const people=list.filter(e=>e.kind==='birthday');
const marks=list.filter(e=>e.kind!=='birthday');
return <li class:list={['day',{weekend:isWeekend(day),eve:isFestivalEve(plan.season,day),busy:list.length>0,festive:list.some(e=>e.kind==='festival'||e.kind==='fair')}]} title={list.map(e=>e.title).join(' · ')||undefined}>
<span class="day-number">{day}</span>
<span class="day-marks">
{people.map(e=>e.person?.icon_path&&<img src={withBase(String(e.person.icon_path))} width="22" height="22" alt="" loading="lazy" />)}
{marks.map(e=><svg class={`mark mark-${e.kind}`} viewBox="0 0 24 24"><path d={CALENDAR_ICONS[e.kind as CalendarIconName]} /></svg>)}
{lateNight(plan.season,day)&&<span class="moon" />}
</span>
</li>;})}</ol>
<p class="month-legend"><span><i class="key-moon" />{t('一定有深夜')}</span><span><i class="key-eve" />{t('没有深夜')}</span><span><i class="key-monday" />{t('周一礼物次数清零')}</span></p>
</div>
<ol class="agenda">{agenda.map(e=><li class={`agenda-item is-${e.kind}`}>
<span class="agenda-date"><b>{e.day}</b><small>{weekdays[weekday(e.day)]}</small></span>
<span class="agenda-icon">{e.kind==='birthday'&&e.person?.icon_path?<img src={withBase(String(e.person.icon_path))} width="36" height="36" alt="" loading="lazy" />:<svg viewBox="0 0 24 24" aria-hidden="true"><path d={CALENDAR_ICONS[e.kind as CalendarIconName]} /></svg>}</span>
<div class="agenda-body">
<p class="agenda-title">{e.person?<a href={url(e.person)}>{e.title}</a>:e.title}{e.time&&<span class="agenda-time">{e.time}</span>}</p>
{e.notes.map(note=><p class="agenda-note" set:html={note} />)}
{e.items&&e.items.length>0&&<p class="agenda-items">{e.kind==='birthday'&&<span class="agenda-label">{t('喜欢')}</span>}{e.items.map(gift=><a class="mini-chip" href={url(gift)}>{gift.icon_path&&<img src={withBase(String(gift.icon_path))} width="22" height="22" alt="" loading="lazy" />}{gift.name.zh_hans}</a>)}</p>}
</div>
</li>)}</ol>
</div>

<div class="lists">
<article class="list-card card">
<h3>{t('狐狸神社供奉')}</h3>
<p class="list-note">{t('第 1 章后在深夜出现。一季最多完成一次，第 N 次完成要交本季前 N 份，交过的一直算数；完成 4 次后神社不再出现。所以渔产只在第 4 次完成时要一次，交那一季的。')}</p>
<ol class="bundles">{plan.shrine.map(row=><li class={`bundle${row.slot===4?' is-last':''}`}>
<span class="slot" aria-label={t('第 {n} 份',{n:row.slot})}>{row.slot}</span>
<div class="bundle-body"><span class="bundle-head"><a class="bundle-name" href={url(row.entity)}>{row.entity.name.zh_hans}</a><span class="clear-tag">{clearTag(row.slot)}</span></span>
<ul class="chips">{row.items.map((stack:PlanStack)=><li><a class="chip" href={url(stack.item)}>{stack.item.icon_path&&<img src={withBase(String(stack.item.icon_path))} width="28" height="28" alt="" loading="lazy" />}<span>{stack.item.name.zh_hans}</span><b>×{stack.quantity}</b></a></li>)}</ul></div>
</li>)}</ol>
{shrineReward&&<p class="reward-line">{t('每次交齐得到')}{[shrineReward.item,aburaage].filter(Boolean).map(reward=><a class="mini-chip" href={url(reward!)}>{reward!.icon_path&&<img src={withBase(String(reward!.icon_path))} width="22" height="22" alt="" loading="lazy" />}{reward!.name.zh_hans}</a>)}<span set:html={tHtml('油豆腐让活力条 +1 段，详见<a href="/guides/cursed-items/#fox-shrine">狐狸神社</a>。')} /></p>}
</article>
<article class="list-card card">
<h3>{t('村长家交付目录')}</h3>
<p class="list-note">{t('在村长家交，交齐一项拿到右边的奖励。')}</p>
<ol class="bundles">{plan.catalog.map(row=><li class="bundle">
<div class="bundle-body"><a class="bundle-name" href={url(row.entity)}>{row.entity.name.zh_hans}</a>
<ul class="chips">{row.items.map((stack:PlanStack)=><li><a class="chip" href={url(stack.item)}>{stack.item.icon_path&&<img src={withBase(String(stack.item.icon_path))} width="28" height="28" alt="" loading="lazy" />}<span>{stack.item.name.zh_hans}</span><b>×{stack.quantity}</b></a></li>)}</ul></div>
{row.rewards.map(reward=><a class="bundle-reward" href={url(reward.item)} title={t('奖励')}>{reward.item.icon_path&&<img src={withBase(String(reward.item.icon_path))} width="32" height="32" alt="" loading="lazy" />}<span><small>{t('奖励')}</small>{reward.item.name.zh_hans}</span></a>)}
</li>)}</ol>
{sharedItems.length>0&&<p class="list-foot">{t('神社也要这些，同一季两边都交的话合计留：')}{sharedItems.map(e=><a class="mini-chip" href={url(e)}>{e.icon_path&&<img src={withBase(String(e.icon_path))} width="22" height="22" alt="" loading="lazy" />}{e.name.zh_hans}<b>×{share(e.id,plan.shrine)+share(e.id,plan.catalog)}</b></a>)}</p>}
</article>
</div>

{(plan.seedNotes.length>0||plan.season===1||plan.season===2)&&<div class="notes">
{plan.seedNotes.length>0&&<article class="note-card card">
<h3>{t('种子要满足条件才上架')}</h3>
<p class="list-note">{t('第 1 年{season}季一开始还买不到下面这些种子，按上架条件分组。',{season:seasonNames[plan.season]})}</p>
<ul class="seed-notes">{plan.seedNotes.map(note=><li><span class="condition">{note.condition}</span><span class="note-items">{note.items.map(e=><a class="mini-chip" href={url(e)}>{e.icon_path&&<img src={withBase(String(e.icon_path))} width="22" height="22" alt="" loading="lazy" />}{e.name.zh_hans}</a>)}</span></li>)}</ul>
</article>}
{plan.season===1&&<article class="note-card card">
<h3>{t('夏季另外要留的')}</h3>
<ul class="tips">
{kappaItem&&<li set:html={tHtml('想做<a href="/guides/night-preparation/#kappa">河童交换</a>的话，供奉之外再留 {count} 个{item}，可以分几次交。奖励按进度给，不会一次全给。',{count:kappa.input_quantity,item:kappaItem.name.zh_hans})} />}
<li set:html={tHtml('毛豆留几株过季：种子说明写着入秋枯萎后变成黄豆。豆芽、毛豆和黄豆是三种收法，产量不能相加，<a href="/data/crops/CROPS_ID_EDAMAME/">各阶段产量</a>。')} />
</ul>
</article>}
{plan.season===2&&<article class="note-card card">
<h3>{t('秋季的菌类')}</h3>
<ul class="tips">
<li>{t('{items}的栽培包在秋季品评会第二天才上架，只在秋季生长，{shimeji}要 {days} 天，所以第 1 年秋季来不及。供奉的秋季蔬菜和目录的秋季蔬菜按第 2 年秋季安排。',{items:list(mushrooms.map(e=>e.name.zh_hans)),shimeji:mushrooms[0]?.name.zh_hans??'',days:Number(shimeji?.growth_days??0)})}</li>
<li set:html={tHtml('种下后可以反复收获，详见<a href="/guides/cultivation-plan/">种植规划</a>。')} />
</ul>
</article>}
</div>}
</section>)}
</section>

<section id="year-round"><h2>{t('不分季节的交付目录')}</h2>
<p>{t('这些项目哪个季节都能交。加工品、畜产品和稀有鱼要提前攒，先挑自己准备做的，不必全部当成本月任务。')}</p>
<div class="year-round">{yearRound.map(page=><article class="list-card card"><h3>{page.page}</h3><ol class="bundles">{page.bundles.map(row=><li class="bundle">
<div class="bundle-body"><a class="bundle-name" href={url(row.entity)}>{row.entity.name.zh_hans}</a>
<ul class="chips">{row.items.map((stack:PlanStack)=><li><a class="chip" href={url(stack.item)}>{stack.item.icon_path&&<img src={withBase(String(stack.item.icon_path))} width="28" height="28" alt="" loading="lazy" />}<span>{stack.item.name.zh_hans}</span><b>×{stack.quantity}</b></a></li>)}</ul></div>
{row.rewards.map(reward=><a class="bundle-reward" href={url(reward.item)} title={t('奖励')}>{reward.item.icon_path&&<img src={withBase(String(reward.item.icon_path))} width="32" height="32" alt="" loading="lazy" />}<span><small>{t('奖励')}</small>{reward.item.name.zh_hans}</span></a>)}
</li>)}</ol></article>)}</div>
<p set:html={tHtml('<a href="/data/activities/?q=村长">村长家交付目录</a> · <a href="/data/activities/?q=建筑">建筑材料</a> · <a href="/guides/residents/">村民喜好与生日</a>')} />
</section>

<section id="new-seeds"><h2>{t('第 2、3 年新增的种子')}</h2>
<p>{t('下面的种子到了对应年份的季节才在店里上架，第 1 年用不到它们的交付项目可以先放着。')}</p>
<div class="later-seeds">{later.map(group=><div class="later-row"><span class="later-when">{t('第 {year} 年{season}季起',{year:group.year,season:seasonNames[group.season]})}</span><span class="note-items">{group.seeds.map(e=><a class="mini-chip" href={url(e)}>{e.icon_path&&<img src={withBase(String(e.icon_path))} width="22" height="22" alt="" loading="lazy" />}{e.name.zh_hans}</a>)}</span></div>)}</div>
</section>

<details class="sources"><summary>{t('数据来源')}</summary>
<p>{t('节日、品评会和通知信的日期：event.dat 的 *_SEND_LETTER、*_MAP_PREPARATION、*_NOTICE_POPUP 与开始、结束时间；名称取自游戏日历的 STR_ID_CALENDAR_*。没有深夜的日子：common.lub 的 isBeforeFestival；第 1、15 天的深夜：event_check_late_night.lub。星期：gamedefine.dat 的 WEEK_* 与 village.exe 0x140106930。')}</p>
<p>{t('送礼次数：village.exe 0x14029ac30 读写村民的 present（当天）和 wkpres（本周），生日当天不计入 wkpres，也不受每周上限限制。供奉与交付：bundle.dat、bundlegroup.dat；生日与喜好：character.dat；种子上架条件：storesales.dat；毛豆转化：item.dat、cropsharvest.dat。安排顺序是本站建议，不是游戏强制流程。')}</p>
</details>
</div>
</BaseLayout>

<script>
  import {onPageMount} from '../../lib/pageLifecycle';
  const dispose=onPageMount(()=>{
    const bar=document.querySelector<HTMLElement>('.season-tabs');
    if(!bar)return;
    const tabs=[...bar.querySelectorAll<HTMLAnchorElement>('[role="tab"]')];
    const panels=tabs.map(tab=>document.getElementById(tab.getAttribute('aria-controls')!)!);
    const header=document.querySelector<HTMLElement>('.site-header');
    const keys=tabs.map(tab=>tab.dataset.seasonTab!);
    const select=(index:number,focus=false)=>{
      tabs.forEach((tab,i)=>{tab.setAttribute('aria-selected',String(i===index));tab.tabIndex=i===index?0:-1;panels[i].hidden=i!==index;});
      if(focus)tabs[index].focus();
    };
    const fromHash=()=>keys.indexOf(location.hash.slice(1));
    // Open the season named in the link, else the site's current season palette.
    const initial=fromHash()>=0?fromHash():Math.max(0,keys.indexOf(document.documentElement.dataset.season??''));
    bar.dataset.ready='';
    select(initial);
    // Hiding the other panels moves the linked one; bring it back into view.
    if(fromHash()>=0)requestAnimationFrame(()=>document.getElementById('seasons')!.scrollIntoView({behavior:'instant'}));
    const measure=()=>bar.parentElement!.style.setProperty('--season-header',`${header?.getBoundingClientRect().height??64}px`);
    const observer=header?new ResizeObserver(measure):null;
    if(header)observer!.observe(header);
    measure();
    const click=(event:MouseEvent)=>{
      const tab=(event.target as Element).closest<HTMLAnchorElement>('[role="tab"]');
      if(!tab||event.ctrlKey||event.metaKey||event.shiftKey||event.altKey||event.button!==0)return;
      event.preventDefault();
      const index=tabs.indexOf(tab);
      select(index);
      history.replaceState(history.state,'',`#${keys[index]}`);
      if(bar.getBoundingClientRect().top<=parseFloat(getComputedStyle(bar).top)+1)document.getElementById('seasons')!.scrollIntoView({behavior:'instant'});
    };
    const key=(event:KeyboardEvent)=>{
      const index=tabs.indexOf(document.activeElement as HTMLAnchorElement);
      if(index<0)return;
      const next={ArrowRight:index+1,ArrowLeft:index-1,Home:0,End:tabs.length-1}[event.key];
      if(next===undefined)return;
      event.preventDefault();
      const target=(next+tabs.length)%tabs.length;
      select(target,true);
      history.replaceState(history.state,'',`#${keys[target]}`);
    };
    const hash=()=>{const index=fromHash();if(index>=0)select(index);};
    bar.addEventListener('click',click);bar.addEventListener('keydown',key);window.addEventListener('hashchange',hash);
    return()=>{observer?.disconnect();bar.removeEventListener('click',click);bar.removeEventListener('keydown',key);window.removeEventListener('hashchange',hash);};
  });
  if(import.meta.hot)import.meta.hot.dispose(dispose);
</script>

<style>
  .season-guide{--chip-bg:color-mix(in srgb,var(--paper-raised) 88%,var(--paper-deep));max-width:1180px}
  .season-guide :is(p,li){line-height:1.65}
  .lede{margin-bottom:1.5rem}
  section{margin:2rem 0;scroll-margin-top:110px}

  /* Daily routine and the planner hand-off */
  .routine{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(260px,1fr);gap:1.25rem;align-items:start}
  .routine h2{margin-top:0}
  .routine ol{list-style:none;margin:0;padding:0;display:grid;gap:.15rem;counter-reset:step}
  .routine li{display:grid;grid-template-columns:7.5rem minmax(0,1fr);gap:.75rem;padding:.55rem 0;border-bottom:1px dashed color-mix(in srgb,var(--border) 70%,transparent);counter-increment:step}
  .routine li:last-child{border-bottom:0}
  .routine li b{color:var(--vermilion);font-size:.9rem;font-weight:750;padding-top:.05rem}
  .routine li span{color:var(--ink)}
  .planner-cta{padding:1.15rem 1.2rem 1.1rem;border-top:3px solid var(--green)}
  .planner-cta .eyebrow{margin:0 0 .3rem}
  .planner-cta h3{margin:0 0 .5rem;font-size:1.15rem}
  .planner-cta p{margin:0 0 .9rem;color:var(--muted);font-size:.93rem}
  .cta-button{display:inline-flex;align-items:center;justify-content:center;width:100%;background:var(--green);border-color:var(--green);color:var(--paper-raised);font-weight:700;text-decoration:none}
  .cta-button:hover{background:color-mix(in srgb,var(--green) 85%,var(--ink));color:var(--paper-raised)}
  .planner-cta small{display:block;margin-top:.55rem;color:var(--muted);font-size:.78rem}
  .cta-secondary{display:block;margin-top:.8rem;padding-top:.75rem;border-top:1px dashed var(--border);font-size:.88rem}

  /* Season tabs */
  .seasons{margin-top:2.5rem}
  .season-tabs{position:sticky;top:var(--season-header,64px);z-index:20;display:flex;gap:.35rem;width:fit-content;max-width:100%;margin:0 0 1rem;padding:.3rem;border:1px solid var(--border);border-radius:999px;background:color-mix(in srgb,var(--paper) 90%,transparent);backdrop-filter:blur(10px);overflow-x:auto;scrollbar-width:none}
  .season-tabs:not([data-ready]){position:static}
  .season-tabs a{display:inline-flex;align-items:center;gap:.45rem;min-height:40px;padding:.3rem .95rem .3rem .45rem;border-radius:999px;color:var(--ink);text-decoration:none;font-weight:650;white-space:nowrap;transition:background-color .2s,box-shadow .2s}
  .season-tabs svg{width:28px;height:28px;flex-shrink:0}
  .season-tabs a:hover{background:var(--green-soft)}
  .season-tabs a[aria-selected="true"]{background:var(--green-soft);box-shadow:inset 0 0 0 1.5px var(--green);color:var(--green)}
  .season-tabs a:focus-visible{outline:2px solid var(--green);outline-offset:2px}
  .season-panel{margin:0 0 2.5rem;scroll-margin-top:140px}
  .season-panel:focus-visible{outline:none}
  .panel-head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:.4rem 1.2rem;border-bottom:1px solid var(--border);margin-bottom:1rem}
  .panel-head h2{border:0!important;margin:.2rem 0 .5rem;padding:0!important}
  .panel-head h2::after{display:none!important}
  .panel-links{display:flex;flex-wrap:wrap;gap:.25rem 1rem;font-size:.9rem;padding-bottom:.55rem}

  /* Month grid and agenda */
  .calendar-block{display:grid;grid-template-columns:minmax(300px,380px) minmax(0,1fr);gap:1.25rem;align-items:start}
  .month{position:sticky;top:calc(var(--season-header,64px) + 4.25rem);padding:.8rem .8rem .65rem}
  .month-head,.month-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:3px}
  .month-head span{text-align:center;font-size:.74rem;font-weight:700;color:var(--muted);padding-bottom:.25rem}
  .month-head span:first-child{color:var(--green)}
  .month-head .weekend{color:var(--vermilion)}
  .month-grid{list-style:none;margin:0;padding:0}
  .day{position:relative;display:flex;flex-direction:column;gap:2px;aspect-ratio:1/1.05;min-width:0;padding:3px 4px;border-radius:6px;background:color-mix(in srgb,var(--paper) 60%,transparent);line-height:1!important}
