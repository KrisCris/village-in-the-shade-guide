  .clear-tag{padding:.05rem .5rem;border-radius:999px;background:var(--paper-deep);color:var(--muted);font-size:.72rem;font-weight:600;line-height:1.5;white-space:nowrap}
  .bundle.is-last .slot{background:transparent;border:1.5px dashed color-mix(in srgb,var(--gold) 70%,var(--border));color:var(--gold)}
