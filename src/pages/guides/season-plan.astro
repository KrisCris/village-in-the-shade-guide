  .list-foot{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem .5rem;margin:.6rem 0 0;padding-top:.6rem;border-top:1px solid color-mix(in srgb,var(--border) 55%,transparent);font-size:.86rem;color:var(--muted)}

  .notes{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:1rem;margin-top:1rem}
