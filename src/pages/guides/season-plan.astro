  .agenda-date small{font-size:.72rem;color:var(--muted)}
  .agenda-icon{display:grid;place-items:center;width:2.5rem;height:2.5rem;border-radius:50%;background:var(--green-soft)}
  .agenda-icon img{width:36px;height:36px;border-radius:50%;object-fit:cover}
  .agenda-icon svg{width:22px;height:22px;fill:none;stroke:var(--green);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .is-festival .agenda-icon,.is-fair .agenda-icon{background:color-mix(in srgb,var(--gold) 20%,var(--paper-raised))}
  .is-festival .agenda-icon svg,.is-fair .agenda-icon svg{stroke:var(--gold)}
  .is-end .agenda-icon{background:color-mix(in srgb,var(--muted) 15%,var(--paper-raised))}
  .is-end .agenda-icon svg{stroke:var(--muted)}
  .agenda-body p{margin:0}
  .agenda-title{font-weight:700;display:flex;flex-wrap:wrap;align-items:baseline;gap:.2rem .6rem}
  .agenda-title a{color:var(--ink)}
  .agenda-time{font-weight:600;font-size:.82rem;color:var(--gold);font-variant-numeric:tabular-nums}
  .agenda-note{color:var(--muted);font-size:.88rem}
  .agenda-items{display:flex;flex-wrap:wrap;align-items:center;gap:.3rem;margin-top:.35rem!important}
  .agenda-label{font-size:.78rem;color:var(--muted);margin-right:.15rem}

  /* Chips */
  .chips{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:.35rem}
  .chips li{line-height:1!important}
  .chip,.mini-chip{display:inline-flex;align-items:center;gap:.35rem;border:1px solid color-mix(in srgb,var(--border) 75%,transparent);border-radius:999px;background:var(--chip-bg);color:var(--ink);text-decoration:none;line-height:1.2;transition:border-color .2s,background-color .2s}
  .chip{padding:.15rem .6rem .15rem .2rem;font-size:.9rem}
  .chip img,.mini-chip img{object-fit:contain;flex-shrink:0}
  .chip b{color:var(--vermilion);font-weight:750;font-variant-numeric:tabular-nums;margin-left:.1rem}
  .mini-chip{padding:.1rem .5rem .1rem .15rem;font-size:.82rem}
  .mini-chip b{color:var(--vermilion);font-weight:750;font-variant-numeric:tabular-nums}
  .chip:hover,.mini-chip:hover{border-color:var(--green);background:var(--green-soft)}

  /* Delivery lists */
  .lists{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1.25rem}
  .list-card{padding:1rem 1.1rem}
  .list-card h3{margin:0 0 .25rem;font-size:1.08rem}
  .list-note{margin:0 0 .6rem;color:var(--muted);font-size:.86rem}
  .bundles{list-style:none;margin:0;padding:0}
  .bundle{display:flex;align-items:center;gap:.75rem;padding:.6rem 0;border-top:1px solid color-mix(in srgb,var(--border) 55%,transparent)}
  .slot{display:grid;place-items:center;flex-shrink:0;width:1.6rem;height:1.6rem;border-radius:50%;background:var(--green-soft);color:var(--green);font-weight:800;font-size:.82rem}
  .bundle-body{flex:1;min-width:0;display:grid;gap:.35rem}
  .bundle-name{font-weight:700;color:var(--ink);text-decoration:none;font-size:.93rem}
