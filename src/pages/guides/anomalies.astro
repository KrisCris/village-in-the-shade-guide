---
import { withBase } from '../../lib/sitePath';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnomalyMap from '../../components/AnomalyMap.astro';
import {getCatalog,entityUrl} from '../../data/repository';
import {minimapImage} from '../../data/collectionMap';
import type {MapLayer,MapShape} from '../../data/anomalyMap';
import anomalies from '../../../data/sources/game-anomalies.json';
import art from '../../../data/sources/game-anomaly-art.json';
import { getI18n } from '../../i18n/server';
const {t,tHtml,href,locale}=getI18n(Astro.url);
const catalog=getCatalog(locale);
const RANDOM='GameGetRandomLateNightItemID';
const view=(id:string)=>{const e=catalog.entities.find(e=>e.kind==='items'&&e.id===id);return e&&{name:e.name.zh_hans,icon:e.icon_path,url:href(entityUrl(e))};};
const name=(id:string)=>view(id)?.name??id;
type Reward={item:string,count:number};
const chips=(rewards:Reward[])=>rewards.map(r=>r.item===RANDOM?{name:t('随机深夜道具'),count:r.count}:{...view(r.item),count:r.count}).filter(c=>c.name);
const one=(...ids:string[])=>chips(ids.map(item=>({item,count:1})));
const event=(id:string)=>anomalies.events.find(e=>e.id===`LATE_NIGHT_EVENT_${id}`)!;
const cycle=(id:string)=>(event(id).rewards as {steps:Reward[][]}).steps.map(chips);
const fujin=event('FUJIN_RAIJIN').rewards as unknown as {fujin:{steps:Reward[][]},raijin:{steps:Reward[][]},both_in_one_night:Reward[],mizuchi_per_side:number};
const cow=anomalies.unknown_livestock;
const cowSteps=cow.dig_rewards.map(r=>chips([r]));
const tablets=anomalies.tablets.map(tab=>({...view(tab.item),anchor:{STATUE_GAME:'daruma',HAND_EYES:'hand-eyes',SOOT_SPRITE:'soot-sprite',MASK:'mask',GRASS:'nozuchi'}[tab.late_night_event.replace('LATE_NIGHT_EVENT_','')]}));
const anomalyName:Record<string,string>={daruma:t('一二三木头人'),'hand-eyes':t('手之目'),'soot-sprite':t('煤炭球'),mask:t('面具之夜'),nozuchi:t('野槌蛇')};
const [red,blue,redRecipes,blueRecipes]=anomalies.mask_night_pickups;
const pickupChips=(group:typeof red)=>one(...group.items.map(i=>i.item));
const masks=one('ITEM_ID_CURSE_FURNITURE_FOX_MASK','ITEM_ID_CURSE_FURNITURE_TENGU_MASK','ITEM_ID_CURSE_FURNITURE_DEMON_MASK','ITEM_ID_CURSE_FURNITURE_MASK_OF_OKAME');
const altar=view('ITEM_ID_SHINTO_ALTAR');
const salt=view('ITEM_ID_CURSED_PURIFYING_SALT');
const [startHour,endHour]=anomalies.late_night.hours;
const night=anomalies.night_events;
const hits=anomalies.hand_eyes_monuments.hits;
const abyss=night.abyss;
const abyssTotal=(n:number)=>abyss.need_per_level.slice(0,n).reduce((a,b)=>a+b,0);
const scarecrows=t('随机一种季节稻草人');
const pictures=art.images as Record<string,{width:number,height:number}>;
const pic=(slug:string,label:string)=>({src:withBase(`/art/anomalies/${slug}.webp`),label,...pictures[slug]});
const image=withBase(minimapImage(locale));
const points=anomalies.map_points as Record<string,Array<{x:number,y:number}>>;
const layer=(label:string,color:string,shape:MapShape,key:string,start?:number):MapLayer=>({label,color,shape,points:points[key],start});
const C={red:'#e2553f',blue:'#4a86e8',purple:'#a46be6',gold:'#f2b632',white:'#f4f1e8',green:'#4cbf75',cyan:'#3fc8d0',orange:'#f08a3c',pink:'#f07fb5'};
const nav=[['late-night',t('深夜什么时候来')],['shelf',t('妖怪置物架与木牌')],['hand-eyes',t('手之目')],['daruma',t('一二三木头人')],['soot-sprite',t('煤炭球')],['nozuchi',t('野槌蛇')],['mask',t('面具之夜')],['kasa-ghost',t('角笠妖')],['fujin-raijin',t('风神与雷神')],['snow-woman',t('雪女')],['demon',t('鬼')],['night-events',t('其他夜间事件')]];
const nightNav=[['petopeto',t('黏黏妖')],['giant-rabbit',t('巨大兔')],['red-phone',t('鲜红的手机与长发女')],['doll',t('日本人偶')],['dorotabo',t('泥田坊')],['cursed-produce',t('妖怪蔬菜与妖怪鱼')],['abyss',t('龙神渊的池主')],['ghost-cow',t('牛鬼')],['ghost-rats',t('幽灵老鼠与机械部件')]];
---
<BaseLayout title={t('怪异出现条件与对策')}><h1>{t('怪异出现条件与对策')}</h1>
<p>{t('第一章结束后，深夜 {start} 点到 {end} 点会出现下面这些怪异。每张卡片写出现条件、遇到后会怎样、怎么解决和解决后的奖励，地图标出石碑、地藏、坟墓等固定位置。',{start:startHour,end:endHour})}</p>
<nav class="toc" aria-label={t('本页目录')}>{nav.map(([id,label])=><a href={`#${id}`}>{label}</a>)}</nav>

<section id="late-night"><h2>{t('深夜什么时候来')}</h2><ul>
<li>{t('每周一决定这一周有几次深夜（3 或 4 次），之后隔 1–2 天来一次，剩下的次数排进这周余下的日子。')}</li>
<li>{t('下雷雨、每季第 1 天和第 15 天，以及妖怪置物架上放了木牌的那晚，一定会进入深夜。')}</li>
<li>{t('节日前一晚不会有深夜。')}</li>
<li>{t('在妖怪置物架上放净化盐，下一次深夜会取消，雷雨天和第 1、15 天也一样。')}</li>
<li>{t('每次深夜发生一种怪异，从当晚满足季节、天气和剧情条件的怪异里选。')}</li>
</ul></section>

<section id="shelf"><h2>{t('妖怪置物架与木牌')}</h2>
<p>{t('第一章结束后，深夜经过村里的岔路口会捡到妖怪置物架（“安心生活模式”下不会触发）。摆好后把木牌放上去，那晚一定进入深夜，并发生木牌对应的怪异。木牌放一次就用掉。')}</p>
<div class="items">{altar&&<a href={altar.url}>{altar.icon&&<img src={withBase(altar.icon)} width="44" height="44" alt="" loading="lazy"/>}{altar.name}</a>}{salt&&<a href={salt.url}>{salt.icon&&<img src={withBase(salt.icon)} width="44" height="44" alt="" loading="lazy"/>}{salt.name}</a>}</div>
<table class="tablets"><thead><tr><th>{t('木牌')}</th><th>{t('对应怪异')}</th></tr></thead><tbody>{tablets.map(tab=><tr><td>{tab.url&&<a class="item" href={tab.url}>{tab.icon&&<img src={withBase(tab.icon)} width="32" height="32" alt="" loading="lazy"/>}{tab.name}</a>}</td><td><a href={`#${tab.anchor}`}>{anomalyName[tab.anchor!]}</a></td></tr>)}</tbody></table>
<p>{t('第一次遇到某种怪异后，它的木牌会加入村内和追加农地的深夜拾取物。角笠妖、风神雷神、雪女和鬼没有木牌。')}</p></section>

<section><h2>{t('深夜怪异')}</h2><div class="anomalies">

<article class="card" id="hand-eyes"><h3>{t('手之目')}</h3><div class="art">{[pic('hand-eyes',t('手之目')),pic('lantern',t('灯笼妖')),pic('monument-small',t('小石碑')),pic('monument-big',t('大石碑'))].map(p=><figure><img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async"/><figcaption>{p.label}</figcaption></figure>)}</div>
<p class="conds"><span class="pill">{t('不限季节和天气')}</span></p>
<div class="body"><div>
<h4>{t('会发生什么')}</h4><p>{t('村里出现灯笼妖，有原地不动的，也有沿路线来回走的。被灯笼的光照到，手之目会从附近现身追你；甩掉它后，灯笼回到原处。')}</p>
<h4>{t('怎么解决')}</h4><p>{t('地图上的 5 座小石碑每次都会全部出现，位置固定。用十字镐敲 {small} 下打碎一座；5 座都碎后，星号处出现大石碑，敲 {big} 下打碎就算解决。',{small:hits.GIMMICK_ID_EVENT_EVILEYE_STONE_MONUMENT_SMALL,big:hits.GIMMICK_ID_EVENT_EVILEYE_STONE_MONUMENT_BIG})}</p>
<p>{t('石碑只在你开着灯时看得见，也只有开着灯才敲得动；5:00 以后敲不动。')}</p>
<h4>{t('奖励（每次解决给下一项，循环）')}</h4><ol class="cycle">{cycle('HAND_EYES').map(step=><li>{step.map(c=>c.url?<a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}{c.count>1&&` ×${c.count}`}</a>:<span>{c.name} ×{c.count}</span>)}</li>)}</ol>
</div><AnomalyMap image={image} label={t('手之目：石碑与灯笼妖的位置')} layers={[layer(t('小石碑'),C.purple,'number','evil_eye_stone'),layer(t('大石碑'),C.gold,'star','evil_eye_monument_big'),layer(t('灯笼妖（不动）'),C.orange,'dot','lantern_fixed'),layer(t('灯笼妖（移动）出发点'),C.white,'dot','lantern_move')]}/></div></article>

<article class="card" id="daruma"><h3>{t('一二三木头人')}</h3><div class="art">{[pic('daruma',t('不倒翁')),pic('black-daruma-stone',t('石头')),pic('black-daruma',t('黑色不倒翁'))].map(p=><figure><img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async"/><figcaption>{p.label}</figcaption></figure>)}</div>
<p class="conds"><span class="pill">{t('不限季节和天气')}</span></p>
<div class="body"><div>
<h4>{t('会发生什么')}</h4><p>{t('村里出现围起来的区域和几块圆石，不倒翁会追你。倒数“一二三木头人”后，不倒翁睁眼：睁眼期间移动、跳跃、点按或使用道具都会挨打，扣 2 颗心。这时躲起来可以结束这一轮。')}</p>
<h4>{t('怎么解决')}</h4><p>{t('睁眼期间，圆石会变成黑色不倒翁。站在它面前用十字镐敲碎（这一下不算犯规；没睁眼时敲不坏），捡起碎片就算解决。')}</p>
<p>{t('圆石由游戏每晚从地图上的 {count} 个位置里挑选摆放。',{count:points.daruma_stone.length})}</p>
<h4>{t('奖励（每次解决给下一项，循环）')}</h4><ol class="cycle">{cycle('STATUE_GAME').map(step=><li>{step.map(c=>c.url?<a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}{c.count>1&&` ×${c.count}`}</a>:<span>{c.name} ×{c.count}</span>)}</li>)}</ol>
</div><AnomalyMap image={image} label={t('一二三木头人：圆石可能出现的位置')} layers={[layer(t('圆石可能出现的位置'),C.white,'dot','daruma_stone')]}/></div></article>

<article class="card" id="soot-sprite"><h3>{t('煤炭球')}</h3><div class="art">{[pic('soot-sprite',t('煤炭球')),pic('boss-soot-sprite',t('大煤炭球'))].map(p=><figure><img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async"/><figcaption>{p.label}</figcaption></figure>)}</div>
<p class="conds"><span class="pill">{t('不限季节和天气')}</span></p>
<div class="body"><div>
<h4>{t('会发生什么')}</h4><p>{t('遇到煤炭球后过一会儿，黑雾会罩住画面并熄掉你的灯。黑雾还在、你又没躲起来时，会一次 1 颗心地持续扣血。')}</p>
<h4>{t('怎么解决')}</h4><p>{t('重新开灯，黑雾散开，煤炭球和大煤炭球随之出现。被灯光照到的煤炭球会减速逃开。大煤炭球是一团中间带红圈的黑雾，只有 1 点体力，任何武器打中一下就倒，打倒它就算解决。')}</p>
<h4>{t('奖励（每次解决给下一项，循环）')}</h4><ol class="cycle">{cycle('SOOT_SPRITE').map(step=><li>{step.map(c=>c.url?<a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}{c.count>1&&` ×${c.count}`}</a>:<span>{c.name} ×{c.count}</span>)}</li>)}</ol>
</div><AnomalyMap image={image} label={t('煤炭球与大煤炭球的出现点')} layers={[layer(t('大煤炭球出现点'),C.red,'number','boss_soot_sprite'),layer(t('煤炭球出现点'),C.white,'dot','soot_sprite')]}/></div></article>

<article class="card" id="nozuchi"><h3>{t('野槌蛇')}</h3><div class="art">{[pic('night-grass',t('夜草')),pic('nozuchi-tail',t('野槌蛇的尾巴')),pic('nozuchi',t('野槌蛇'))].map(p=><figure><img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async"/><figcaption>{p.label}</figcaption></figure>)}</div>
<p class="conds"><span class="pill">{t('第 1 年夏季起')}</span></p>
<h4>{t('会发生什么')}</h4><p>{t('村里长满夜草，其中混着会动的拟态夜草（外观和夜草一样），还会出现扭扭妖。夜草只有镰刀割得动。野槌蛇用身体撞人，一下扣 4 颗心。')}</p>
<h4>{t('尾巴从哪里冒出来')}</h4><p>{t('尾巴和野槌蛇都没有固定位置，只会从你刚割掉的那棵夜草处冒出。每割一棵，先判定冒不冒尾巴，没冒再判定冒不冒野槌蛇；这一晚割得越多，几率越高。')}</p>
<ul><li>{t('尾巴：割到第 10 棵以后，每多割一棵几率加 0.01%，平均要割 135 棵左右才见到一次。')}</li><li>{t('野槌蛇：割到第 10 棵以后，每多割一棵几率加 0.2%，平均割 40 棵左右就会冒出来。')}</li><li>{t('冒出后对应的计数清零。同一时间最多一条尾巴、一条野槌蛇。')}</li></ul>
<h4>{t('怎么解决')}</h4><p>{t('尾巴是插在地里的一段红光，露出 15 秒后消失。趁它还在时打中它，累计 3 次就算解决。')}</p>
<h4>{t('奖励（每次解决给下一项，循环）')}</h4><ol class="cycle">{cycle('GRASS').map(step=><li>{step.map(c=>c.url?<a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}{c.count>1&&` ×${c.count}`}</a>:<span>{c.name} ×{c.count}</span>)}</li>)}</ol></article>

<article class="card" id="mask"><h3>{t('面具之夜')}</h3><div class="art">{[pic('red-mask',t('红面灵气')),pic('blue-mask',t('蓝面灵气')),pic('purple-mask',t('紫面灵气'))].map(p=><figure><img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async"/><figcaption>{p.label}</figcaption></figure>)}</div>
<p class="conds"><span class="pill">{t('第 1 年夏季起')}</span></p>
<h4>{t('会发生什么')}</h4><p>{t('手电筒会坏掉，只能点蜡烛照明。红色小贩和蓝色小贩出现，分别卖{red}和{blue}。',{red:name('ITEM_ID_CURSED_RED_CANDLE'),blue:name('ITEM_ID_CURSED_BLUE_CANDLE')})}</p>
<ul><li>{t('红面灵气：红色蜡烛每烧掉 5%，你面前就出现一只，停留 15 秒。只要你点着红色蜡烛，它就冲过来；灭掉蜡烛或换成别的灯 3 秒后，它停下。蓝面灵气对蓝色蜡烛也一样。')}</li>
<li>{t('紫面灵气：有 21 个出现点。你点着红色或蓝色蜡烛时它不动；没有烛光时，它会四处找你，看到就追，跟丢后回到原处。')}</li></ul>
<h4>{t('怎么解决')}</h4><p>{t('这一晚没有解决奖励，收获是烛光照出的闪光点。深夜结束后手电筒恢复，剩下的蜡烛会被收走。')}</p>
<h4>{t('闪光点在哪里')}</h4><p>{t('红色闪光点和蓝色闪光点各有 21 个固定位置，每晚每种颜色在其中放 14～20 个，要点着同色蜡烛才看得见。每种颜色另外还会放 1 张面具设计图。')}</p>
<div class="body"><AnomalyMap image={image} label={t('面具之夜：红色和蓝色闪光点的位置')} layers={[layer(t('红色闪光点'),C.red,'dot','mask_item_red'),layer(t('蓝色闪光点'),C.blue,'dot','mask_item_blue')]}/><AnomalyMap image={image} label={t('面具之夜：小贩和紫面灵气的位置')} layers={[layer(t('红色小贩'),C.red,'square','red_merchant'),layer(t('蓝色小贩出现点'),C.blue,'square','blue_merchant'),layer(t('紫面灵气出现点'),C.purple,'dot','purple_mask_ghost')]}/></div>
<h4>{t('红色烛光照出')}</h4><div class="chips">{pickupChips(red).map(c=><a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}</a>)}</div>
<p class="note">{t('设计图（4 选 1）：')}</p><div class="chips">{pickupChips(redRecipes).map(c=><a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}</a>)}</div>
<h4>{t('蓝色烛光照出')}</h4><div class="chips">{pickupChips(blue).map(c=><a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}</a>)}</div>
<p class="note">{t('设计图（4 选 1）：')}</p><div class="chips">{pickupChips(blueRecipes).map(c=><a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}</a>)}</div>
<p>{t('两种碎片最常见。壁挂面具在工作台用 15 个红色或蓝色碎片，加狩猎或家畜材料制作：')}</p>
<div class="chips">{masks.map(c=><a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}</a>)}</div></article>

<article class="card" id="kasa-ghost"><h3>{t('角笠妖')}</h3><div class="art">{[pic('kasa-ghost',t('角笠妖')),pic('jizo',t('地藏'))].map(p=><figure><img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async"/><figcaption>{p.label}</figcaption></figure>)}</div>
<p class="conds"><span class="pill">{t('雨夜')}</span></p>
<div class="body"><div>
<h4>{t('会发生什么')}</h4><p>{t('独脚的角笠妖在村里出现，会攻击你。它打不伤也打不倒。')}</p>
<h4>{t('怎么解决')}</h4><p>{t('等它一次攻击刚结束，把它举起来，搬到地藏前给地藏戴上。4 尊地藏排在同一处（地图星号），4 尊都戴上就算解决。')}</p>
<h4>{t('奖励（每次解决给下一项，循环）')}</h4><ol class="cycle">{cycle('KASA_GHOST').map(step=><li>{step.map(c=>c.url?<a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}{c.count>1&&` ×${c.count}`}</a>:<span>{c.name} ×{c.count}</span>)}</li>)}</ol><p class="note">{t('已经解锁斗笠饰品时，跳过斗笠这一项。')}</p>
</div><AnomalyMap image={image} label={t('角笠妖出现点与地藏的位置')} layers={[layer(t('地藏'),C.gold,'star','jizo'),layer(t('角笠妖出现点'),C.white,'dot','hat_ghost')]}/></div></article>

<article class="card" id="fujin-raijin"><h3>{t('风神与雷神')}</h3><div class="art">{[pic('fujin',t('风神')),pic('raijin',t('雷神')),pic('mizuchi-fujin',t('蛟（风神）')),pic('mizuchi-raijin',t('蛟（雷神）'))].map(p=><figure><img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async"/><figcaption>{p.label}</figcaption></figure>)}</div>
<p class="conds"><span class="pill">{t('雷雨夜')}</span></p>
<div class="body"><div>
<h4>{t('会发生什么')}</h4><p>{t('风神和雷神出现，雷神会降下落雷。')}</p>
<h4>{t('怎么解决')}</h4><p>{t('村里会出现属于风神和属于雷神的蛟，各分大小两种，出现点见地图。蛟不会主动攻击，只在出现点附近 20 格内游荡。大蛟要打 3 下，小蛟 1 下，什么武器都行。每打倒一只，对应的神会发动一次攻击。')}</p>
<p>{t('打倒某一方的蛟累计 {count} 只（大小都算 1 只），就能击退那位神。进度跨夜保留，两边都满 {count} 只后才清零。',{count:fujin.mizuchi_per_side})}</p>
<h4>{t('风神的奖励（循环）')}</h4><ol class="cycle">{fujin.fujin.steps.map(chips).map(step=><li>{step.map(c=><a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}</a>)}</li>)}</ol>
<h4>{t('雷神的奖励（循环）')}</h4><ol class="cycle">{fujin.raijin.steps.map(chips).map(step=><li>{step.map(c=><a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}</a>)}</li>)}</ol>
<p>{t('同一晚击退两位神（这晚开始时两位都还在）时，另外掉落：')}</p><div class="chips">{chips(fujin.both_in_one_night).map(c=><a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}</a>)}</div>
</div><AnomalyMap image={image} label={t('风神和雷神的蛟出现点')} layers={[layer(t('蛟（风神）'),C.green,'number','mizuchi_fujin'),layer(t('蛟（风神）（小）'),C.green,'dot','mizuchi_fujin_small'),layer(t('蛟（雷神）'),C.gold,'square','mizuchi_raijin'),layer(t('蛟（雷神）（小）'),C.gold,'dot','mizuchi_raijin_small')]}/></div></article>

<article class="card" id="snow-woman"><h3>{t('雪女')}</h3><div class="art">{[pic('snow-woman',t('雪女')),pic('snow-child',t('雪童子')),pic('husband-grave',t('丈夫的坟墓'))].map(p=><figure><img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async"/><figcaption>{p.label}</figcaption></figure>)}</div>
<p class="conds"><span class="pill">{t('冬季')}</span><span class="pill">{t('雪夜')}</span></p>
<div class="body"><div>
<h4>{t('会发生什么')}</h4><p>{t('深夜开始时，雪女在农场入口出现，把婴儿交给你，请你带孩子去见父亲。你放下婴儿时，雪女会追你；重新抱起一会儿后她才消失。雪童子在附近游荡，看到你会追过来。')}</p>
<h4>{t('怎么解决')}</h4><p>{t('抱着婴儿走到丈夫的坟墓，在墓前放下。坟墓有 3 个固定位置，每晚只在其中随机 1 处出现；5:00 坟墓消失，要在这之前放下。')}</p>
<h4>{t('奖励（每次解决给下一项，循环）')}</h4><ol class="cycle">{cycle('SNOW_WOMAN').map(step=><li>{step.map(c=>c.url?<a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}{c.count>1&&` ×${c.count}`}</a>:<span>{c.name} ×{c.count}</span>)}</li>)}</ol>
</div><AnomalyMap image={image} label={t('雪女：坟墓候选位置与雪童子出现点')} layers={[layer(t('坟墓候选位置'),C.cyan,'number','husband_grave'),layer(t('雪女现身处'),C.white,'star','snow_woman_intro'),layer(t('雪童子出现点'),C.white,'dot','snow_child')]}/></div></article>

<article class="card" id="demon"><h3>{t('鬼')}</h3><details><summary>{t('第四章剧透：出现条件与打法')}</summary>
<p class="conds"><span class="pill">{t('第四章在大洞前打倒津主后')}</span><span class="pill">{t('每季第 1、15 天')}</span></p>
<h4>{t('会发生什么')}</h4><p>{t('鬼会扔燃烧的岩石，还有冲撞、拍地和一击让你倒下的攻击。')}</p>
<h4>{t('怎么解决')}</h4><p>{t('用十字镐把扔来的燃烧岩石打回去，才能伤到鬼。鬼的体力是 6。')}</p>
<h4>{t('奖励（每次解决给下一项，循环）')}</h4><ol class="cycle">{cycle('DEMON').map(step=><li>{step.map(c=><a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}{c.count>1&&` ×${c.count}`}</a>)}</li>)}</ol></details></article>
</div>
<p class="note">{t('“随机深夜道具”由游戏随机决定给哪一种深夜道具。')}</p></section>

<section id="night-events"><h2>{t('其他夜间事件')}</h2>
<p>{t('下面这些事件不在深夜怪异的轮换里，各有自己的触发条件。')}</p>
<nav class="toc" aria-label={t('其他夜间事件目录')}>{nightNav.map(([id,label])=><a href={`#${id}`}>{label}</a>)}</nav>
<div class="anomalies">

<article class="card" id="petopeto"><h3>{t('黏黏妖')}</h3><div class="art">{[pic('petopeto',t('黏黏妖'))].map(p=><figure><img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async"/><figcaption>{p.label}</figcaption></figure>)}</div>
<p class="conds"><span class="pill">{t('0:00–5:00')}</span></p>
<div class="body"><div>
<p>{t('长着许多手脚的白色圆球，深夜待在村子南边（地图 1 号）。走到它身边后，它会沿路往南走，过桥后在隘口隧道前（2 号）停下。')}</p>
<p>{t('跟着它走就行。落后超过 20 格，它会发怒，速度加倍冲向你；发怒后你躲起来，它就会消失，这一晚算失败。')}</p>
<p>{t('它在终点停下后，再碰它一下，会得到奖励（循环）：')}</p>
<ol class="cycle">{[...one(night.petopeto.rewards[0].item,night.petopeto.rewards[1].item).map(c=><li><a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}</a></li>),<li><span>{scarecrows}</span></li>]}</ol>
<p class="note">{t('已经解锁的饰品会跳过。')}</p>
</div><AnomalyMap image={image} label={t('黏黏妖的起点和终点')} layers={[layer(t('起点'),C.white,'number','petopeto'),layer(t('终点'),C.cyan,'number','petopeto_goal',2)]}/></div></article>

<article class="card" id="giant-rabbit"><h3>{t('巨大兔')}</h3><div class="art">{[pic('giant-rabbit-moon',t('像月亮的光球')),pic('giant-rabbit',t('巨大兔'))].map(p=><figure><img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async"/><figcaption>{p.label}</figcaption></figure>)}</div>
<p class="conds"><span class="pill">{t('0:00–6:00')}</span></p>
<div class="body"><div>
<p>{t('深夜沿山路走到尽头（地图星号），会看到一个像月亮的光球，那就是巨大兔。5:00 前碰到它，会触发事件并得到奖励（循环）：')}</p>
<ol class="cycle">{[...one(...night.giant_rabbit.rewards.slice(0,3).map(r=>r.item)).map(c=><li><a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}</a></li>),<li><span>{scarecrows}</span></li>]}</ol>
<p class="note">{t('已经解锁的睡帽、睡衣会跳过。')}</p>
</div><AnomalyMap image={image} label={t('巨大兔的位置')} layers={[layer(t('巨大兔'),C.gold,'star','giant_rabbit')]}/></div></article>

<article class="card" id="red-phone"><h3>{t('鲜红的手机与长发女')}</h3><div class="art">{[pic('red-phone',name('ITEM_ID_CURSED_RED_MOBILE_PHONE')),pic('long-hair-lady',t('长发女'))].map(p=><figure><img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async"/><figcaption>{p.label}</figcaption></figure>)}</div>
<p class="conds"><span class="pill">{t('第二章结束后')}</span></p>
<div class="body"><div><ol class="steps">
<li>{t('电话亭事件第一次发生后，「{phone}」会出现在地图上 5 个点中随机 1 处。没捡走的话，每晚 0:00 重新放一次。',{phone:name('ITEM_ID_CURSED_RED_MOBILE_PHONE')})}</li>
<li>{t('捡起后带在身上。深夜 5:00 前，捡起 15 分钟后手机会响；挂断后每过 30 分钟再响。躲起来会把下一次响铃推迟 30 分钟。')}</li>
<li>{t('手机响时，长发女会在离你 10～20 格的地方出现并追你。选中手机就能挂断；躲起来时，她会走到附近，然后电话挂断。')}</li>
<li>{t('趁手机响着走到电话亭（地图星号），接起电话。看完过场后，手机变成「{broken}」。',{broken:name('ITEM_ID_CURSED_BROKEN_MOBILE_PHONE')})}</li>
<li>{t('把「{broken}」交给杂货店的茶梅，得到：',{broken:name('ITEM_ID_CURSED_BROKEN_MOBILE_PHONE')})}<div class="chips">{one(...night.phone_booth.rewards).map(c=><a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}</a>)}</div></li>
</ol></div><AnomalyMap image={image} label={t('鲜红的手机候选点与电话亭')} layers={[layer(t('手机候选点'),C.pink,'number','red_phone'),layer(t('电话亭'),C.red,'star','phone_box')]}/></div></article>

<article class="card" id="doll"><h3>{t('日本人偶')}</h3><div class="art">{[pic('doll-body',name('ITEM_ID_CURSE_FURNITURE_JAPANESE_DOLL_BODY')),pic('doll-walking',t('走动的人偶')),pic('doll-head',name('ITEM_ID_CURSE_FURNITURE_JAPANESE_DOLL_HEAD'))].map(p=><figure><img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async"/><figcaption>{p.label}</figcaption></figure>)}</div>
<p class="conds"><span class="pill">{t('第一章结束后')}</span></p>
<div class="body"><div><ol class="steps">
<li>{t('深夜 0:00–5:00，地图 1 号处会出现一个没有头的日本人偶，捡起来就是「{body}」（家具）。没捡走的话，之后每晚都会再出现。',{body:name('ITEM_ID_CURSE_FURNITURE_JAPANESE_DOLL_BODY')})}</li>
<li>{t('把它摆在家里或院子里。第二天它会转过身去，再过一天会倒下。')}</li>
<li>{t('倒下后的下一个 0:00，人偶从摆放处消失，出现在 2 号处。')}</li>
<li>{t('靠近它，它会起身走到 3 号，再走到 4 号，在那里掉下「{head}」。',{head:name('ITEM_ID_CURSE_FURNITURE_JAPANESE_DOLL_HEAD')})}</li>
<li>{t('捡起头，会同时拿到头和身体，并获得日本人偶的设计图，用来制作：')}<div class="chips">{one('ITEM_ID_CURSE_FURNITURE_JAPANESE_DOLL').map(c=><a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}</a>)}</div></li>
</ol></div><AnomalyMap image={image} label={t('日本人偶事件的位置')} layers={[layer(t('人偶身体出现处'),C.white,'number','doll_body_item'),layer(t('人偶起身处'),C.pink,'number','doll_walking',2),layer(t('人偶走过的路线'),C.pink,'number','doll_route',3)]}/></div></article>

<article class="card" id="dorotabo"><h3>{t('泥田坊')}</h3><div class="art">{[pic('dorotabo',t('泥田坊'))].map(p=><figure><img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async"/><figcaption>{p.label}</figcaption></figure>)}</div>
<p class="conds"><span class="pill">{t('第一章结束后')}</span><span class="pill">{t('0:00–2:59')}</span></p>
<div class="body"><div>
<p>{t('深夜 0:00–2:59 经过村里几处特定地点时，泥田坊会在附近出现（圆点），走到同号的田地（方块），种下一颗{seed}后消失。种下时正在下雨，会顺便浇好水。',{seed:name('ITEM_ID_CROPS_MUD_SEEDS')})}</p>
<p>{t('它种的东西像普通作物一样照料，长 2 天后收获，得到：')}</p><div class="chips">{one(night.dorotabo.grown_harvest).map(c=><a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}</a>)}</div>
<p>{t('第一次遇到时立刻发生。之后要等上一次种下的东西从田里消失、并且隔了 7 天，泥田坊才会再来。')}</p>
</div><AnomalyMap image={image} label={t('泥田坊出现点与它去种植的田地')} layers={[layer(t('泥田坊出现点'),C.gold,'number','dorotabo'),layer(t('它去种植的田地'),C.orange,'square','dorotabo_field')]}/></div></article>

<article class="card" id="cursed-produce"><h3>{t('妖怪蔬菜与妖怪鱼')}</h3><div class="art">{[pic('fish-monster',t('妖怪鱼'))].map(p=><figure><img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async"/><figcaption>{p.label}</figcaption></figure>)}</div>
<div class="body"><div>
<p>{t('脚本的设定是每丢弃或出货 1 个「被诅咒的」作物，下一次深夜开始时多出 1 只妖怪蔬菜，被诅咒的鱼对应妖怪鱼。可是 1.30 的判断条件只认普通的作物、花、果实和鱼，被诅咒的物品对不上，计数从不增加。按游戏数据，这两种妖怪不会出现。')}</p>
<ul><li>{t('妖怪蔬菜：从你脚下钻出来。地面先有 2 秒预兆，赶紧走开；被撞到扣 4 颗心。它 6 秒后自己消失。')}</li>
<li>{t('妖怪鱼：从河边的出现点出来，看到你就追，跟丢你 30 多秒后消失。')}</li></ul>
<p>{t('被诅咒的作物和鱼还可以扔进龙神渊换奖励，见下一项。')}</p>
</div><AnomalyMap image={image} label={t('妖怪鱼出现点')} layers={[layer(t('妖怪鱼出现点'),C.cyan,'dot','fish_monster')]}/></div></article>

<article class="card" id="abyss"><h3>{t('龙神渊的池主')}</h3><div class="art">{[pic('abyss-carp',t('池主'))].map(p=><figure><img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async"/><figcaption>{p.label}</figcaption></figure>)}</div>
<p class="conds"><span class="pill">{t('第一章结束后')}</span></p>
<div class="body"><div><ol class="steps">
<li>{t('身上带着被诅咒的作物或鱼去找今野说话，付 {price} 日元打听消息。',{price:abyss.tip_price})}</li>
<li>{t('之后到龙神渊水边（地图星号），选中被诅咒的道具扔进水里。画面会显示还差几个。')}</li>
<li>{t('数量够了以后，如果是深夜 0:00–4:59，池主会马上出现并给奖励；白天凑够的话，深夜再来一趟。')}</li>
</ol>
<table class="tablets"><thead><tr><th>{t('次数')}</th><th>{t('要扔几个')}</th><th>{t('奖励')}</th></tr></thead><tbody>
{abyss.need_per_level.map((need,i)=><tr><td>{i<6?i+1:t('{n} 次以后',{n:7})}</td><td>{need}</td><td>{i<5?t('「{item}」，体力上限 +1',{item:name('ITEM_ID_CURSED_HEART_SCALE')}):i===5?t('学会唤雨呼笛'):t('随机一个「{red}」或「{black}」',{red:name('ITEM_ID_CURSE_FURNITURE_CARP_LANTERN_1'),black:name('ITEM_ID_CURSE_FURNITURE_CARP_LANTERN_2')})}</td></tr>)}
</tbody></table>
<p class="note">{t('前 5 次一共要扔 {hearts} 个，换来 5 颗心；第 7 次以后每 15 个换一盏灯笼。',{hearts:abyssTotal(5)})}</p>
</div><AnomalyMap image={image} label={t('龙神渊的位置')} layers={[layer(t('龙神渊'),C.cyan,'star','abyss_carp')]}/></div></article>

<article class="card" id="ghost-cow"><h3>{t('牛鬼')}</h3><p class="conds"><span class="pill">{t('第一章结束后')}</span><span class="pill">{t('需要畜舍')}</span></p>
<h4>{t('会发生什么')}</h4><p>{t('建好畜舍后约 15 天，畜舍里会多出一头陌生的牛，就是牛鬼（每季第 21–27 天不会出现）。它不产出任何东西。它在的时候，品评会计分的心情最多按 100 算，到不了“好”（180），心情分最多加 4。')}</p>
<h4>{t('怎么解决')}</h4><p>{t('在 {window} 之间打开畜舍的门（从外面或里面开都可以），牛会走到村里某处停下。在它停下的地方挖出埋着的东西就算解决，牛随后消失；5 点前没挖，它会回到畜舍。解决后过一段时间，它会再次出现。',{window:cow.move_window})}</p>
<h4>{t('奖励')}</h4><ol class="cycle">{cowSteps.map((step,i)=><li>{step.map(c=><a href={c.url}>{c.icon&&<img src={withBase(c.icon)} width="32" height="32" alt="" loading="lazy"/>}{c.name}{c.count>1&&` ×${c.count}`}</a>)}{i===0&&<span>{t('，并学会呼唤家畜的第二首口哨')}</span>}</li>)}</ol><p class="note">{t('第 3 次之后，在第 2 项和第 3 项之间交替。')}</p></article>

<article class="card" id="ghost-rats"><h3>{t('幽灵老鼠与机械部件')}</h3><div class="art">{[pic('ghost-rat',t('幽灵老鼠'))].map(p=><figure><img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async"/><figcaption>{p.label}</figcaption></figure>)}</div>
<p set:html={tHtml('开着灯、带着干酪靠近幽灵老鼠，选中干酪交给它，再跟着它走，它停下的地方会掉出古钱。古钱扔进老鼠井。老鼠的位置、机械部件和遗失图书都在<a href="/guides/collection-map/#ghost-rats">夜间收集地图</a>上；雷兽、豆腐小僧、猫又和河童的交换见<a href="/guides/night-preparation/">夜间交换与勾玉准备</a>。')} /></article>
</div></section>

<details><summary>{t('游戏数据来源')}</summary><ul>
<li>{t('深夜频率、强制深夜与净化盐：event_check_late_night 的 awakeLateNight_check。')}</li>
<li>{t('各怪异的季节、天气、日期和剧情条件：latenightevent.dat；全部开始事件都要求第一章结束（event.dat）。')}</li>
