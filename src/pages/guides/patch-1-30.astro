---
import GuideItem from '../../components/GuideItem.astro';
import AnomalyMap from '../../components/AnomalyMap.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCatalog,entityUrl} from '../../data/repository';
import { getI18n } from '../../i18n/server';
import { withBase } from '../../lib/sitePath';
import { minimapImage } from '../../data/collectionMap';
import { visitorId } from '../../data/mysteryVisitor';
import visitorData from '../../../data/sources/game-mystery-visitor.json';
import anomalyData from '../../../data/sources/game-anomalies.json';
const {t,tHtml,href,locale}=getI18n(Astro.url);
const catalog=getCatalog(locale);
const item=(id:string)=>catalog.byId[id];
const url=(id:string)=>href(entityUrl(catalog.byId[id]));
const money=(id:string)=>t('金钱 {money}',{money:Number(item(id)?.buy_price??0).toLocaleString('en-US')});
// ai_chara_template.lub talkStart_birthday pairs each resident with ITEM_ID_BIRTHDAY_PRESENT_<role>.
const roles=['VILLAGE_HEAD','ORPHAN','CARPENTER','LUMBERJACK','HUNTER','GENERAL_STORE_MANAGER','OLD_MAN','SECRETARY','CITY_HALL_STAFF','GIRL','YOUNG_MAN','BOY','FEMALE_DOCTOR','STREET_VENDOR'];
const presents=roles.map(role=>({person:item(`CHARA_ID_${role}`),present:`ITEM_ID_BIRTHDAY_PRESENT_${role}`}));
// Areas from each tier's item.dat description; blacksmith.dat rows 21–24 cost one mold and five ingots.
const seeders=[
  {id:'ITEM_ID_TOOL_SEEDER_1',area:'3×1'},
  {id:'ITEM_ID_TOOL_SEEDER_2',area:'5×1',mold:'ITEM_ID_COPPER_MOLD',ingot:'ITEM_ID_COPPER_INGOT'},
  {id:'ITEM_ID_TOOL_SEEDER_3',area:'3×3',mold:'ITEM_ID_IRON_MOLD',ingot:'ITEM_ID_IRON_INGOT'},
  {id:'ITEM_ID_TOOL_SEEDER_4',area:'4×4',mold:'ITEM_ID_GOLD_MOLD',ingot:'ITEM_ID_GOLD_INGOT'},
  {id:'ITEM_ID_TOOL_SEEDER_5',area:'5×5',mold:'ITEM_ID_MRTRORITE_MOLD',ingot:'ITEM_ID_METEORIC_IRON_INGOT'},
];
const bath=catalog.entities.filter(e=>e.kind==='store-offers'&&/^STORE_SALE_ID_GENERAL_ADDITIONAL_00(1[1-9]|20)$/.test(e.id)).map(e=>String(e.item_id));
const greenDye=catalog.entities.filter(e=>e.kind==='processes'&&/^GIMMICK_PROCESS_ITEM_DYE_GREEN_1?[234]$/.test(e.id));
const firstInput=(process:typeof greenDye[number])=>String((process.inputs as {item_id:string}[])[0].item_id);
const greenInputs=[...new Set(greenDye.map(firstInput))];
const link=(id:string)=>`<a href="${url(id)}">${item(id)?.name.zh_hans??id}</a>`;
const birthdayQuest=item('QUEST_ID_PLAYER_BIRTHDAY');
// The "？？？" event (tools/extract-mystery-visitor.py): the game's own lines in the page language.
const visitor=item(visitorId);
const visitorLines=visitorData.dialogue.flatMap(step=>step.lines.map(line=>line[locale]));
const visitorMap=[
  {label:t('事件发生处'),color:'#f2b632',shape:'star' as const,points:[visitorData.anchor]},
  {label:t('触发位置'),color:'#f4f1e8',shape:'dot' as const,points:visitorData.triggers.map(({center:[x,y]})=>({x,y}))},
  {label:t('电话亭'),color:'#e2553f',shape:'square' as const,points:anomalyData.map_points.phone_box},
];
---
<BaseLayout title={t('1.30 更新：生日、播种机与卫浴设备')}><h1>{t('1.30 更新：生日、播种机与卫浴设备')}</h1>
<p>{t('1.30 版本加入了主角生日、播种机和卫浴设备家具。这些内容都要先满足条件，触发解锁事件或收到来信后才会开放。解锁事件在部分主线剧情期间和雷雨天不会发生。')}</p>
<nav><a href="#birthday">{t('主角生日')}</a>　<a href="#seeder">{t('播种机')}</a>　<a href="#bath">{t('卫浴设备')}</a>　<a href="#mystery">{t('“？？？”事件')}</a>　<a href="#other">{t('其他改动')}</a></nav>

<section id="birthday"><h2>{t('主角生日')}</h2>
<p>{t('进入第二年后，林会寄来一封信，请你到地图上标记的地点见面（7:00–16:59）。见面时可以设定主角的生日。')}</p>
<ul>
<li>{t('静谧田园模式：通关主线后的隔天起。')}</li>
<li>{t('安心生活模式：名护搬进村子后的隔天起。')}</li>
</ul>
<p set:html={tHtml('生日当天早上会收到林的信和一份<a href="{cake}">{cakeName}</a>，任务栏里会出现“{quest}”。信里说关系好的居民会记得你的生日，当天和他们交谈可以收到礼物。每位居民当天只送一份，背包满了会掉在脚边。',{cake:entityUrl(item('ITEM_ID_BIRTHDAY_CAKE')),cakeName:item('ITEM_ID_BIRTHDAY_CAKE')?.name.zh_hans??'',quest:birthdayQuest?.name.zh_hans??''})} />
<table><thead><tr><th>{t('居民')}</th><th>{t('生日礼物')}</th></tr></thead><tbody>
{presents.map(({person,present})=><tr><th scope="row">{person?<a href={href(entityUrl(person))}>{person.name.zh_hans}</a>:''}</th><td><GuideItem entity={item(present)} href={url(present)}/></td></tr>)}
</tbody></table>
<p>{t('这些礼物都是摆件，大多放在桌子或架子上。')}</p>
</section>

<section id="seeder"><h2>{t('播种机')}</h2>
<p set:html={tHtml('岔路祠堂修复完第三阶段后，茶梅会来信。之后可以在田上杂货店买到<a href="{url}">{name}</a>（{price}，限购一台）。',{url:entityUrl(item('ITEM_ID_TOOL_SEEDER_1')),name:item('ITEM_ID_TOOL_SEEDER_1')?.name.zh_hans??'',price:money('ITEM_ID_TOOL_SEEDER_1')})} />
<p>{t('官方更新说明写的是“祠堂修复到第三阶段”；游戏数据检查的是第 4 组祠堂修复交付（木材和石材）是否完成。')}</p>
<p>{t('播种机能把选好的种子、秧苗或肥料一次撒在已经翻好的田地或水田上。和其他工具一样，可以在铁砧升级，每级用 1 个铸模和 5 根金属条。')}</p>
<div class="table-scroll"><table><thead><tr><th>{t('播种机')}</th><th>{t('播种范围')}</th><th>{t('升级材料')}</th></tr></thead><tbody>
{seeders.map(s=><tr><th scope="row"><GuideItem entity={item(s.id)} href={url(s.id)}/></th><td>{s.area}</td><td>{s.mold?<span class="pair"><GuideItem entity={item(s.mold)} href={url(s.mold)} note="×1"/><GuideItem entity={item(s.ingot!)} href={url(s.ingot!)} note="×5"/></span>:t('商店购买')}</td></tr>)}
</tbody></table></div>
</section>

<section id="bath"><h2>{t('卫浴设备')}</h2>
<p>{t('取得狐狸的狩猎执照后，茶梅会来信说进了卫浴设备。之后田上杂货店会出售下面 10 件家具，每件只能买一次。')}</p>
<div class="items">{bath.map(id=><GuideItem entity={item(id)} href={url(id)} note={money(id)}/>)}</div>
<p set:html={tHtml('狐狸执照的取得方法见<a href="/guides/hunting-plan/">狩猎执照与材料</a>。')} />
</section>

<section id="mystery"><h2>{t('“？？？”事件')}</h2>
<p>{t('仅限静谧田园模式：设定生日的隔天起，会发生一段新事件。官方更新说明只写了“？？？”。')}</p>
<details class="spoiler"><summary>{t('剧透：触发地点和对话')}</summary>
<p set:html={tHtml('事件里出现的是一位还没有名字的人物，对话时名字只显示“{name}”。立绘和资料见<a href="{href}">他的角色页</a>。',{name:visitor?.name.zh_hans??'',href:url(visitorId)})} />
<ul>
<li>{t('7:00–16:59 走上村子南边的桥，或桥东边的小路，就会触发。事件在桥头、电话亭附近进行。')}</li>
<li>{t('雷雨天不会发生。每个存档只发生一次。')}</li>
</ul>
<AnomalyMap image={withBase(minimapImage(locale))} label={t('“？？？”事件的触发位置')} layers={visitorMap} minWidth={900}/>
<h3>{t('对话')}</h3>
<blockquote class="talk">{visitorLines.map(line=><p><b>{visitor?.name.zh_hans}</b>{line}</p>)}</blockquote>
<p>{t('游戏数据把这段事件标为“追加角色的伏笔”，他的立绘资源叫“角色_01（暂定）”。1.30 里没有别的事件、对话或日程再用到他，“我会再来的”要等以后的更新。')}</p>
</details>
</section>

<section id="other"><h2>{t('其他改动')}</h2>
<ul>
<li set:html={t('{dye}更容易做了：{machine}除了{oak}，也能用{inputs}加{bones}或{resin}来做。',{dye:link('ITEM_ID_DYE_GREEN'),machine:link('ITEM_ID_GIMMICK_OIL_EXTRACTION_MACHINE'),oak:link('ITEM_ID_OBJECT_KASHIWA_LEAF'),inputs:greenInputs.map(link).join(t('、')),bones:link('ITEM_ID_HUNTING_SMALL_ANIMAL_BONES'),resin:link('ITEM_ID_OBJECT_PINE_FAT')})} />
<li>{t('把东西交给居民的距离变远了。')}</li>
<li>{t('畜舍、温室等建筑移建时可以左右翻转。建筑里摆着的家具会收进树木建设的箱子。')}</li>
<li>{t('取名最多 8 个字，并且可以输入汉字。')}</li>
<li>{t('品牌名可以在图鉴画面重新修改。')}</li>
<li>{t('狗会进狗屋了。')}</li>
<li>{t('游戏语言设为英语、法语或西班牙语时，以前收不到林关于追加农地的来信；1.30 的数据去掉了这个限制。')}</li>
</ul>
</section>

<details class="sources"><summary>{t('数据来源')}</summary><p>{t('updatetext.dat 的 UPDATE_TEXT_1_30（官方更新说明）；event.dat 的 EVENT_ID_PLAYER_BIRTHDAY_*、EVENT_ID_SALE_START_SEEDER、EVENT_ID_SALE_START_BATH_SERIES 和 EVENT_ID_DLC_03_001；charactertalk.dat 与 ai_chara_template 脚本的生日对话；letter.dat 的生日信和茶梅来信；storesales.dat、blacksmith.dat 与 gimmickprocess.dat；“？？？”事件：dlc_03_01 脚本、talk.dat 的 TALK_ID_90_3002_001_*、demolist.dat 的 DEMO_ID_DLC_03_001_L/R 与村庄地图里的触发区域、creature.dat 与 anime.dat 的人物条目。')}</p></details>
</BaseLayout>
<style>section{margin:2rem 0;scroll-margin-top:90px}p,li{line-height:1.8}table{width:100%}td,th{vertical-align:middle}.pair{display:flex;flex-wrap:wrap;gap:.3rem 1rem}.items{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:.5rem}.items .guide-item{padding:.4rem .6rem;border-radius:10px;background:var(--paper-raised);color:var(--ink)}details{padding:1rem;border:1px solid var(--border);border-radius:10px;margin:.7rem 0}summary{cursor:pointer;font-weight:bold}.spoiler[open] summary{margin-bottom:.8rem}.talk{margin:.5rem 0;padding:.4rem 1rem;border-left:3px solid var(--border);background:var(--paper-raised);border-radius:0 10px 10px 0}.talk p{margin:.35rem 0}.talk b{margin-right:.8em;color:var(--muted)}</style>
