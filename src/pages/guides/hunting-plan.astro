---
import { withBase } from '../../lib/sitePath';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCatalog,entityUrl} from '../../data/repository';
const catalog=getCatalog();
const item=(id:string)=>catalog.entities.find(e=>e.kind==='items'&&e.id===id);
const licenses=catalog.entities.filter(e=>e.kind==='items'&&e.category_id==='ITEM_CATEGORY_HUNTING_LICENSE').sort((a,b)=>Number(a.buy_price)-Number(b.buy_price));
const gear=catalog.entities.filter(e=>e.kind==='items'&&e.category_id==='ITEM_CATEGORY_HUNTING_GEAR');
const rewards=catalog.entities.filter(e=>e.kind==='hunt-rewards');
---
<BaseLayout title="狩猎执照与材料规划"><h1>狩猎执照与材料规划</h1>
<nav><a href="#licenses">执照预算</a>　<a href="#rewards">证明换什么</a>　<a href="#gear">狩猎工具</a></nav>
<section><h2>先按材料需求选择猎物</h2><ol><li>从建筑、制作或料理目标点开缺少的材料，再对照下方狩猎证明的报酬。不要只按执照价格从低到高全部购买。</li><li>检查对应执照是否已经取得。执照不仅允许狩猎，也关系到对应区域能否进入；购买前把执照费用与工具准备一起计入预算。</li><li>狩猎取得证明后，交到猎人小屋的小箱子换报酬。证明与肉、皮、骨等实物不是同一件东西。</li><li>报酬到手后先分出制作和交付所需，余量再用于料理或出售。允许“肉类”替换的料理可从<a href={withBase("/guides/cooking-plan/#ingredients")}>料理材料表</a>挑选材料，不必消耗唯一一份稀缺猎物材料。</li></ol></section>
<section id="licenses"><h2>执照预算</h2><div class="grid">{licenses.map(license=>{const offers=catalog.entities.filter(e=>e.kind==='store-offers'&&e.item_id===license.id);return <article class="card"><a class="name" href={withBase(entityUrl(license))}>{license.icon_path&&<img src={withBase(license.icon_path)} width="52" height="52" alt="" loading="lazy"/>}<strong>{license.name.zh_hans}</strong></a><p>{offers.length?'商店记录已确认':'购买途径待核对'} · 基础买价 {license.buy_price}</p>{offers.map(offer=><p><a href={withBase(entityUrl(offer))}>{((offer.conditions??[]) as string[]).join('；')||'查看售卖记录'}</a></p>)}</article>;})}</div><p>鹿的执照基础买价为 10,000。游戏执照说明与鹿区域围栏脚本都确认它控制鹿出没区域的进入权限；钓点路线另见<a href={withBase("/data/fish/")}>鱼类钓点筛选</a>。</p></section>
<section id="rewards"><h2>狩猎证明报酬</h2><div class="grid">{rewards.map(reward=>{const certificate=item(String(reward.certificate_item_id));return certificate&&<article class="card"><h3><a class="name" href={withBase(entityUrl(certificate))}>{certificate.icon_path&&<img src={withBase(certificate.icon_path)} width="48" height="48" alt="" loading="lazy"/>}{certificate.name.zh_hans}</a></h3><ul>{((reward.rewards??[]) as {item_id:string;quantity:number}[]).map(r=>{const entry=item(r.item_id);return entry&&<li><a class="name" href={withBase(entityUrl(entry))}>{entry.icon_path&&<img src={withBase(entry.icon_path)} width="36" height="36" alt="" loading="lazy"/>}{entry.name.zh_hans} ×{r.quantity}</a></li>;})}</ul></article>;})}</div></section>
<section id="gear"><h2>狩猎工具</h2><div class="grid">{gear.map(e=><a class="card name" href={withBase(entityUrl(e))}>{e.icon_path&&<img src={withBase(e.icon_path)} width="48" height="48" alt="" loading="lazy"/>}{e.name.zh_hans}</a>)}</div></section>
<details><summary>游戏数据来源</summary><p>item.dat、store.dat：执照价格、说明与售卖条件；huntreward.dat：狩猎证明报酬；tips.dat 的 TIPS_36_HUNTING_CERTIFICATE：交付地点；gimmick_hunting_license_sign_fence.lub：执照标记与围栏通行状态。这里不把未核对的命中次数或刷新概率写成保证。</p></details>
</BaseLayout>
<style>section{margin:2rem 0;scroll-margin-top:90px}p,li{line-height:1.8}li{margin:.5rem 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:.8rem}.card{padding:1rem}.card h3{margin-top:0}.name{display:flex;align-items:center;gap:.5rem;text-decoration:none}.name img{object-fit:contain}.card ul{padding-left:1rem}nav{line-height:2}</style>
