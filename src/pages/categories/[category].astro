---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LazyEntityExplorer from '../../components/table/LazyEntityExplorer';
import {getCatalog} from '../../data/repository';
import { getI18n } from '../../i18n/server';
export function getStaticPaths(){return [...new Set(getCatalog().entities.filter(e=>e.kind==='items'&&e.category_id).map(e=>e.category_id))].map(category=>({params:{category}}));}
const { t, href, locale } = getI18n(Astro.url);
const rows=getCatalog(locale).entities.filter(e=>e.kind==='items'&&e.category_id===Astro.params.category);
const title=t('{category}一览', { category: rows[0]?.category_name?.zh_hans ?? t('物品') });
---
<BaseLayout title={title}><a href={href("/categories/")}>← {t('物品分类')}</a><h1>{title}</h1><LazyEntityExplorer source={`/list-data/category-${Astro.params.category}.json`} client:load locale={locale} /></BaseLayout>
