---
import { withBase } from '../../lib/sitePath';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LazyEntityExplorer from '../../components/table/LazyEntityExplorer';
import {getCatalog} from '../../data/repository';
export function getStaticPaths(){return [...new Set(getCatalog().entities.filter(e=>e.kind==='items'&&e.category_id).map(e=>e.category_id))].map(category=>({params:{category}}));}
const rows=getCatalog().entities.filter(e=>e.kind==='items'&&e.category_id===Astro.params.category);
const title=rows[0]?.category_name?.zh_hans ?? '物品';
---
<BaseLayout title={`${title}一览`}><a href={withBase("/categories/")}>← 物品分类</a><h1>{title}一览</h1><LazyEntityExplorer source={`/list-data/category-${Astro.params.category}.json`} client:load /></BaseLayout>
