---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AsyncWorkflowPlanner from '../../components/workflow/AsyncWorkflowPlanner';
import { getI18n } from '../../i18n/server';
const { t, locale } = getI18n(Astro.url);
---
<BaseLayout title={t('农场生产工作流')} description={t('按天编排种植、续种、多级加工、供奉交付与出售，计算共享资源和每日收支。')}>
  <div class="workflow-page-shell"><AsyncWorkflowPlanner client:only="react" locale={locale}><p slot="fallback">{t('正在打开农场生产工作流…')}</p></AsyncWorkflowPlanner></div>
</BaseLayout>
<style is:global>
  body.wiki-page:has(.workflow-page-shell){height:100dvh;min-height:0;overflow:hidden}
  body:has(.workflow-page-shell)>.site-header{flex-shrink:0}
  body:has(.workflow-page-shell)>.page{display:block;max-width:none;padding:0;min-height:0;overflow:hidden}
  body:has(.workflow-page-shell) .main{max-width:none;min-width:0;width:100%;height:100%;padding:0;background:transparent;border:0}
  body:has(.workflow-page-shell) :is(.sidebar,.site-footer,.falling-leaves){display:none}
  .workflow-page-shell{height:100%;min-height:0}
  body:has(.workflow-page-shell) .main .wf-breadcrumb h1{margin:0;padding:0;letter-spacing:.05em}
  body:has(.workflow-page-shell) .main .wf-breadcrumb h1::after{display:none}
</style>
