---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntityExplorer from '../../../components/table/EntityExplorer';
import { getCatalog } from '../../../data/repository';
import { visibleRowsForKind } from '../../../data/catalogViews';
import { groupProcessesByOutput } from '../../../domain/processGroups';
import { kindLabels } from '../../../data/types';
export function getStaticPaths() {
  const catalog = getCatalog();
  return Object.keys(catalog.counts).map((kind) => ({ params: { kind }, props: { kind } }));
}
const { kind } = Astro.props;
const catalog = getCatalog();
const rawRows = visibleRowsForKind(catalog, kind);
const rows = kind === 'processes' ? groupProcessesByOutput(rawRows, catalog) : rawRows;
const machineOptions = catalog.entities.filter((entity) => entity.kind === 'machines').map((entity) => ({ id: entity.id, name: entity.name.zh_hans }));
const referencedItemIds = kind === 'processes' ? new Set(rawRows.flatMap((entity) => {
  const inputs = (entity.inputs ?? []) as Array<{ item_id: string }>;
  const output = entity.output as { item_id?: string } | undefined;
  return [...inputs.map((input) => input.item_id), ...(output?.item_id ? [output.item_id] : [])];
})) : new Set<string>();
const priceIndex = Object.fromEntries([...referencedItemIds].flatMap((id) => {
  const item = catalog.byId[id];
  return item ? [[id, { sell_price: item.sell_price, quality_eligible: item.quality_eligible }]] : [];
}));
const label = kindLabels[kind] ?? kind;
const fishingLocationOptions = [...new Map(rows.flatMap((row) => ((row.locations ?? []) as Array<{location_id: string; name: {zh_hans: string}}>).map((place) => [place.location_id, {id: place.location_id, name: place.name.zh_hans}] as const))).values()].sort((a, b) => a.id.localeCompare(b.id));
const itemCategoryOptions = [...new Map([...rows].sort((a, b) => Number(a.category_numeric_id) - Number(b.category_numeric_id)).flatMap((row) => row.category_id && row.category_name ? [[row.category_id, {id: row.category_id, name: row.category_name.zh_hans}] as const] : [])).values()];
---
<BaseLayout title={label} description={`${label}完整数据表，支持中文、日文和内部 ID 搜索。`}>
  <h1>{label}</h1>
  {['crops','processes'].includes(kind) && <p><a href="/planner/">种植与加工收益排行 →</a></p>}
  <p class="muted">共 {rows.length} 条</p>
  <EntityExplorer client:load rows={rows} kind={kind} machineOptions={machineOptions} fishingLocationOptions={fishingLocationOptions} itemCategoryOptions={itemCategoryOptions} priceIndex={priceIndex} />
</BaseLayout>
